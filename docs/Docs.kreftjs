<!-- Kreft documentation viewer (docs/Docs.kreftjs)
     Reads docs/README.md, shows it as a manual: parts and chapters on the left, the page in the middle,
     "On this page" on the right. It sits under the site header, so it uses the site's colours (ui.css),
     including the light/dark switch. Keys: ⌘K or / search · [ and ] previous / next chapter · Esc closes. -->
import { markdown } from './markdown.js'

state current = ''
state scrollPct = 0
state showTop = false
state copied = false
state menuOpen = false
state searchOpen = false
state query = ''
state picked = 0
state article = null
state searchInput = null

// Load and read the manual
load doc = (async () => {
    for (const path of ['docs/README.md', '../docs/README.md', '/docs/README.md', '/demo/docs/README.md']) {
      try {
        const res = await fetch(new URL(path, document.baseURI))
        if (!res.ok || /html/.test(res.headers.get('content-type') || '')) continue
        return markdown(await res.text())
      } catch (_) {
        continue
      }
    }
    throw new Error('The documentation file was not found (docs/README.md).')
  })()

derive parts = doc.data ? doc.data.parts : []
derive chapters = doc.data ? doc.data.toc.filter((t) => t.level === 2) : []
derive byId = new Map((doc.data ? doc.data.toc : []).map((t) => [t.id, t]))

// the chapter (a level-2 heading) that the reader is in, even when a level-3 section is on screen
derive chapterId = (() => {
    const t = byId.get(current)
    if (t) return t.level === 3 ? t.parentId : t.id
    return chapters.length ? chapters[0].id : ''
  })()
derive chapter = byId.get(chapterId) || null
derive outline = doc.data ? doc.data.toc.filter((t) => t.level === 3 && t.parentId === chapterId) : []
derive prevChapter = (() => {
    const i = chapters.findIndex((c) => c.id === chapterId)
    return i > 0 ? chapters[i - 1] : null
  })()
derive nextChapter = (() => {
    const i = chapters.findIndex((c) => c.id === chapterId)
    return i >= 0 && i < chapters.length - 1 ? chapters[i + 1] : null
  })()

// search: every word must be in the title or the text of a section; titles come first
derive results = (() => {
    if (!doc.data) return []
    const words = query.toLowerCase().split(/\s+/).filter(Boolean)
    const all = doc.data.sections
    if (!words.length) return chapters.slice(0, 8)
    const out = []
    for (const s of all) {
      const title = s.text.toLowerCase()
      const text = (s.content || '').toLowerCase()
      if (!words.every((w) => title.includes(w) || text.includes(w))) continue
      const inTitle = words.every((w) => title.includes(w))
      let snippet = ''
      if (!inTitle) {
        const at = text.indexOf(words[0])
        const from = Math.max(0, at - 40)
        snippet = (from > 0 ? '…' : '') + s.content.slice(from, from + 120).trim() + '…'
      }
      out.push({ ...s, snippet, score: inTitle ? 0 : 1 })
    }
    return out.sort((a, b) => a.score - b.score).slice(0, 12)
  })()

// what this page remembers between actions. It is state (one copy per page): a plain `let` here would be
// shared by every page that is opened from this file, so a closed page could stop the next one.
// `wanted` is the section named in the address when the page was opened (/docs#authentication): read here, at the
// start, because the router may rewrite the address while the page is still being built
const wanted = typeof window !== 'undefined' ? decodeURIComponent(window.location.hash.slice(1)) : ''
state ctl = { moving: false, moveId: 0, hashPending: !!wanted }

function target(id) {
  return article && article.querySelector('[id="' + id.replace(/["\\]/g, '\\$&') + '"]')
}

// Go to a chapter or section
action go(id, instant) {
  const el = target(id)
  if (!el) return
  current = id
  menuOpen = false
  searchOpen = false
  // keep the page's own address: a bare '#id' would resolve against <base href> and lose /docs
  if (typeof history !== 'undefined' && history.replaceState) history.replaceState(null, '', window.location.pathname + window.location.search + '#' + id)
  ctl.moving = true
  // glide only for short trips: a long smooth scroll across the whole manual just makes the reader wait
  const calm = instant || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) || Math.abs(el.getBoundingClientRect().top) > window.innerHeight * 2.5
  // 'instant', not 'auto': the site's CSS sets scroll-behavior: smooth, which 'auto' would follow
  el.scrollIntoView({ behavior: calm ? 'instant' : 'smooth', block: 'start' })
  // the scroll may still be gliding (or the browser may glide by itself): wait until the page stops moving
  // before the reader's position is read again, or the menu would highlight a section we only passed by
  let last = -1, still = 0, waited = 0
  const mine = ++ctl.moveId     // only the newest jump may end the "moving" state
  const rest = () => {
    if (mine !== ctl.moveId || !article || !article.isConnected) return
    const y = window.scrollY
    still = y === last ? still + 1 : 0
    last = y
    waited += 100
    if (still >= 3 || waited > 3000) { ctl.moving = false; syncScroll() }
    else setTimeout(rest, 100)
  }
  setTimeout(rest, 100)
}

action goTop() {
  current = ''
  if (typeof history !== 'undefined' && history.replaceState) history.replaceState(null, '', window.location.pathname)
  window.scrollTo({ top: 0, behavior: 'smooth' })
}

action openSearch() {
  searchOpen = true
  query = ''
  picked = 0
  setTimeout(() => { if (searchInput) searchInput.focus() }, 30)
}

action closeSearch() {
  searchOpen = false
}

action searchKeys(e) {
  if (e.key === 'ArrowDown') {
    e.preventDefault()
    if (results.length) picked = (picked + 1) % results.length
  } else if (e.key === 'ArrowUp') {
    e.preventDefault()
    if (results.length) picked = (picked - 1 + results.length) % results.length
  } else if (e.key === 'Enter') {
    e.preventDefault()
    if (results[picked]) go(results[picked].id)
  } else if (e.key === 'Escape') {
    closeSearch()
  }
}

action copyLink() {
  const url = window.location.origin + window.location.pathname + (current ? '#' + current : '')
  navigator.clipboard.writeText(url).then(() => {
    copied = true
    setTimeout(() => { copied = false }, 1800)
  })
}

// clicks inside the page: copy buttons and links to other sections
action articleClick(e) {
  const copy = e.target.closest('.copy-btn')
  if (copy) {
    e.preventDefault()
    const code = copy.closest('.code-box') && copy.closest('.code-box').querySelector('code')
    if (code) {
      navigator.clipboard.writeText(code.innerText || code.textContent || '').then(() => {
        const label = copy.textContent
        copy.textContent = 'Copied'
        copy.classList.add('copied')
        setTimeout(() => { copy.textContent = label; copy.classList.remove('copied') }, 1800)
      })
    }
    return
  }
  const a = e.target.closest('a')
  const href = a && a.getAttribute('href')
  if (href && href.startsWith('#')) {
    e.preventDefault()
    go(decodeURIComponent(href.slice(1)))
  }
}

// which section is on screen, and how far down the page the reader is
action syncScroll() {
  const root = document.documentElement
  const top = window.scrollY || root.scrollTop || 0
  const max = (root.scrollHeight - window.innerHeight) || 1
  scrollPct = Math.min(100, Math.max(0, (top / max) * 100))
  showTop = top > 480
  if (ctl.moving || ctl.hashPending || !article || !article.isConnected) return
  let id = ''
  for (const h of article.querySelectorAll('h2[id], h3[id]')) {
    if (h.getBoundingClientRect().top <= 120) id = h.id
    else break
  }
  if (id && id !== current) current = id
}

on ready {
  let frame = 0
  const onScroll = () => {
    if (frame) return
    frame = requestAnimationFrame(() => { frame = 0; syncScroll() })
  }
  const typing = () => {
    const el = document.activeElement
    return el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable)
  }
  const onKey = (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault()
      if (searchOpen) closeSearch()
      else openSearch()
    } else if (e.key === '/' && !searchOpen && !typing()) {
      e.preventDefault()
      openSearch()
    } else if (e.key === 'Escape') {
      if (searchOpen) closeSearch()
      else if (menuOpen) menuOpen = false
    } else if (e.key === ']' && !typing() && !searchOpen && nextChapter) {
      go(nextChapter.id)
    } else if (e.key === '[' && !typing() && !searchOpen && prevChapter) {
      go(prevChapter.id)
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true })
  window.addEventListener('keydown', onKey)
  let gone = false
  onDestroy(() => {          // this page is removed: stop listening, and stop looking for the section
    gone = true
    window.removeEventListener('scroll', onScroll)
    window.removeEventListener('keydown', onKey)
  })
  // a link such as /docs#authentication opens at that section. The page is built after the text has loaded, and the
  // router may move to the top once more while it mounts, so look again a few times until the section stays in place.
  const id = wanted
  let tries = 0, touched = false
  const touch = () => { touched = true }
  const seen = ['wheel', 'touchstart', 'pointerdown', 'keydown']
  seen.forEach((n) => window.addEventListener(n, touch, { passive: true, once: true }))
  const done = () => {
    seen.forEach((n) => window.removeEventListener(n, touch))
    ctl.hashPending = false
    syncScroll()
  }
  // keep putting the section in place until the reader takes over (wheel, touch, key) or about 6 seconds pass
  const settle = () => {
    if (gone) return
    const el = id && target(id)
    if (el) {
      const want = parseFloat(getComputedStyle(el).scrollMarginTop) || 80
      if (Math.abs(el.getBoundingClientRect().top - want) > 40) go(id, true)
      if (touched || ++tries >= 24) return done()
      setTimeout(settle, 250)
    } else if (!touched && ++tries < 40) setTimeout(settle, 150)
    else done()
  }
  if (id) settle()
  syncScroll()
}

<view>
  <div class="dv" dir="ltr">
    <div class="dv-progress" aria-hidden="true"><div style={'width:' + scrollPct + '%'}></div></div>

    <!-- narrow screens: a bar with the menu button and the search -->
    <div class="dv-bar">
      <button type="button" class="dv-btn" @click="menuOpen = !menuOpen" aria-label="Open the menu" aria-expanded={menuOpen ? 'true' : 'false'}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        Menu
      </button>
      <span class="dv-bar-title">{chapter ? chapter.text : 'Documentation'}</span>
      <button type="button" class="dv-btn" @click="openSearch" aria-label="Search the docs">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      </button>
    </div>

    <div k-if="menuOpen" class="dv-overlay" @click="menuOpen = false"></div>

    <div class="dv-grid">
      <!-- left: parts and chapters -->
      <aside class={'dv-side' + (menuOpen ? ' open' : '')} aria-label="Documentation menu">
        <button type="button" class="dv-search" @click="openSearch">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
          <span>Search the docs</span>
          <kbd>⌘K</kbd>
        </button>
        <nav>
          {for part in parts key part.id}
            <div class="dv-part">
              <p class="dv-part-title">{part.title}</p>
              <ul>
                {for item in part.items key item.id}
                  <li>
                    <a href={'#' + item.id} class={chapterId === item.id ? 'on' : ''} @click.prevent="go(item.id)">{item.text}</a>
                  </li>
                {/for}
              </ul>
            </div>
          {/for}
        </nav>
      </aside>

      <!-- middle: the page -->
      <main class="dv-main">
        <div class="dv-crumbs" k-if="chapter">
          <span>{chapter.group}</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg>
          <strong>{chapter.text}</strong>
          <span class="dv-time" k-if="doc.data">· {doc.data.stats.readTimeMinutes} min for the whole manual</span>
        </div>

        <article class="dv-article" k-ref="article" @click="articleClick($event)">
          <div k-if="doc.loading" class="dv-skeleton" aria-busy="true">
            <div class="a"></div><div class="b"></div><div class="b short"></div><div class="c"></div>
          </div>
          <aside k-elif="doc.error" class="callout callout-danger" role="alert">
            <p class="callout-title">Could not load the documentation</p>
            <p>{doc.error.message}</p>
          </aside>
          <div k-else class="dv-body" k-html="doc.data.html"></div>

          <footer class="dv-pager" k-if="doc.data">
            <a k-if="prevChapter" href={'#' + prevChapter.id} class="prev" @click.prevent="go(prevChapter.id)">
              <small>Previous</small>
              <span>{prevChapter.text}</span>
            </a>
            <span k-else></span>
            <a k-if="nextChapter" href={'#' + nextChapter.id} class="next" @click.prevent="go(nextChapter.id)">
              <small>Next</small>
              <span>{nextChapter.text}</span>
            </a>
          </footer>
        </article>
      </main>

      <!-- right: on this page -->
      <aside class="dv-toc" aria-label="On this page">
        <div class="dv-toc-in">
          <p class="dv-toc-title">On this page</p>
          <ul k-if="outline.length">
            {for item in outline key item.id}
              <li><a href={'#' + item.id} class={current === item.id ? 'on' : ''} @click.prevent="go(item.id)">{item.text}</a></li>
            {/for}
          </ul>
          <p k-else class="dv-toc-empty">No sections in this chapter.</p>
          <div class="dv-toc-tools">
            <button type="button" @click="copyLink">{copied ? 'Link copied' : 'Copy link to this section'}</button>
            <button type="button" @click="goTop">Back to top</button>
          </div>
        </div>
      </aside>
    </div>

    <!-- search -->
    <div k-if="searchOpen" class="dv-modal" @click="closeSearch">
      <div class="dv-modal-box" role="dialog" aria-modal="true" aria-label="Search the documentation" @click.stop="">
        <div class="dv-modal-in">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
          <input type="search" k-model="query" k-ref="searchInput" placeholder="Search guides, commands and APIs" autocomplete="off" @keydown="searchKeys($event)">
          <kbd @click="closeSearch">Esc</kbd>
        </div>
        <ul class="dv-results">
          {for (item, idx) in results key item.id}
            <li class={idx === picked ? 'on' : ''} @mouseenter="picked = idx" @click="go(item.id)">
              <span class="r-title">{item.text}</span>
              <span class="r-where">{item.level === 3 ? item.parentTitle + ' · ' : ''}{item.group}</span>
              <span class="r-snippet" k-if="item.snippet">{item.snippet}</span>
            </li>
          {empty}
            <li class="none">Nothing found for "{query}". Try fewer or different words.</li>
          {/for}
        </ul>
        <div class="dv-modal-foot">
          <span><kbd>↑</kbd> <kbd>↓</kbd> move</span>
          <span><kbd>↵</kbd> open</span>
          <span><kbd>Esc</kbd> close</span>
        </div>
      </div>
    </div>

    <button type="button" class={'dv-top' + (showTop ? ' show' : '')} @click="goTop" aria-label="Back to top">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
    </button>
  </div>
</view>

<style>
.dv {
  --dv-bar: 60px;                              /* height of the site header above */
  --dv-accent: var(--primary, #18181b);
  --dv-code-bg: var(--terminal-bg, #09090b);
  --dv-code-fg: var(--terminal-fg, #f4f4f5);
  --dv-soft: var(--accent, #f4f4f5);
  --dv-line: var(--border, #e4e4e7);
  --dv-text: var(--foreground, #09090b);
  --dv-muted: var(--muted, #52525b);
  color: var(--dv-text);
  font-family: var(--font, system-ui, sans-serif);
  position: relative;
}
.dv *, .dv *::before, .dv *::after { box-sizing: border-box; }

/* reading progress */
.dv-progress { position: fixed; inset: 0 0 auto 0; height: 2px; z-index: 60; pointer-events: none; }
.dv-progress div { height: 100%; background: var(--dv-accent); transition: width .1s linear; }

/* the three columns */
.dv-grid { display: grid; grid-template-columns: 260px minmax(0, 1fr) 220px; gap: 0 40px; align-items: start; }
.dv-side, .dv-toc { position: sticky; top: calc(var(--dv-bar) + 16px); max-height: calc(100vh - var(--dv-bar) - 32px); overflow: auto; }
.dv-side { padding: 20px 8px 24px 0; scrollbar-width: thin; }
.dv-main { min-width: 0; padding: 24px 0 64px; }
.dv-toc { margin-top: 28px; scrollbar-width: thin; }
.dv-toc-in { padding-inline-start: 16px; border-inline-start: 1px solid var(--dv-line); }

/* menu */
.dv-search { display: flex; align-items: center; gap: 10px; width: 100%; height: 38px; padding: 0 10px; margin-bottom: 18px; background: var(--background, #fff); color: var(--dv-muted); border: 1px solid var(--dv-line); border-radius: var(--radius, 6px); font: inherit; font-size: 14px; cursor: pointer; text-align: start; }
.dv-search:hover { border-color: var(--dv-muted); color: var(--dv-text); }
.dv-search span { flex: 1; }
.dv kbd { font-family: var(--mono, monospace); font-size: 11px; line-height: 1; padding: 3px 6px; color: var(--dv-muted); background: var(--dv-soft); border: 1px solid var(--dv-line); border-radius: 4px; }
.dv-part { margin-bottom: 22px; }
.dv-part-title { margin: 0 0 6px; padding: 0 10px; font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--dv-muted); }
.dv-part ul, .dv-toc ul { list-style: none; margin: 0; padding: 0; }
.dv-part a { display: block; padding: 6px 10px; border-radius: var(--radius, 6px); color: var(--dv-muted); font-size: 14px; line-height: 1.35; text-decoration: none; }
.dv-part a:hover { color: var(--dv-text); background: var(--dv-soft); }
.dv-part a.on { color: var(--dv-text); background: var(--dv-soft); font-weight: 600; }

/* right column */
.dv-toc-title { margin: 0 0 8px; font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--dv-muted); }
.dv-toc li a { display: block; padding: 4px 0; font-size: 13px; line-height: 1.4; color: var(--dv-muted); text-decoration: none; }
.dv-toc li a:hover, .dv-toc li a.on { color: var(--dv-text); }
.dv-toc li a.on { font-weight: 600; }
.dv-toc-empty { margin: 0; font-size: 13px; color: var(--dv-muted); }
.dv-toc-tools { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--dv-line); }
.dv-toc-tools button { padding: 0; background: none; border: 0; font: inherit; font-size: 13px; color: var(--dv-muted); cursor: pointer; }
.dv-toc-tools button:hover { color: var(--dv-text); text-decoration: underline; }

/* breadcrumb */
.dv-crumbs { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; font-size: 13px; color: var(--dv-muted); }
.dv-crumbs strong { color: var(--dv-text); font-weight: 600; }
.dv-time { margin-inline-start: auto; }

/* the page itself */
.dv-article { max-width: 780px; }
.dv-body { font-size: 16px; line-height: 1.75; }
.dv-body > :first-child { margin-top: 0; }
.dv-body p { margin: 0 0 16px; }
.dv-body a { color: var(--dv-text); text-decoration: underline; text-decoration-color: var(--dv-line); text-underline-offset: 3px; }
.dv-body a:hover { text-decoration-color: currentColor; }
.dv-body strong { font-weight: 600; }
.dv-body ul, .dv-body ol { margin: 0 0 16px; padding-inline-start: 22px; }
.dv-body li { margin: 4px 0; }
.dv-body li > p { margin: 6px 0; }
.dv-body hr { margin: 36px 0; border: 0; border-top: 1px solid var(--dv-line); }

.dv-body .doc-heading { position: relative; scroll-margin-top: calc(var(--dv-bar) + 20px); font-weight: 650; letter-spacing: -.01em; }
.dv-body .heading-anchor { position: absolute; inset-inline-start: -22px; opacity: 0; color: var(--dv-muted); text-decoration: none; font-weight: 400; }
.dv-body .doc-heading:hover .heading-anchor { opacity: 1; }
.dv-body .doc-h1 { margin: 72px 0 8px; padding-top: 28px; border-top: 1px solid var(--dv-line); font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--dv-muted); }
.dv-body .doc-h1:first-child { margin-top: 0; padding-top: 0; border-top: 0; }
.dv-body .doc-h2 { margin: 28px 0 14px; font-size: 32px; line-height: 1.2; }
.dv-body .doc-h3 { margin: 40px 0 12px; font-size: 21px; line-height: 1.3; }
.dv-body .doc-h4 { margin: 28px 0 8px; font-size: 17px; }

/* inline code and keys */
.dv-body :not(pre) > code { padding: 2px 6px; font-family: var(--mono, monospace); font-size: .88em; background: var(--dv-soft); border: 1px solid var(--dv-line); border-radius: 5px; }

/* code blocks: always dark, with the language and a copy button */
.dv-body .code-box { margin: 0 0 20px; overflow: hidden; background: var(--dv-code-bg); color: var(--dv-code-fg); border: 1px solid var(--dv-line); border-radius: var(--radius-lg, 8px); }
.dv-body .code-head { display: flex; align-items: center; justify-content: space-between; padding: 6px 10px 6px 14px; border-bottom: 1px solid rgba(255,255,255,.08); }
.dv-body .code-lang { font-family: var(--mono, monospace); font-size: 11px; letter-spacing: .08em; color: rgba(244,244,245,.55); }
.dv-body .copy-btn { padding: 3px 9px; background: transparent; color: rgba(244,244,245,.75); border: 1px solid rgba(255,255,255,.16); border-radius: 5px; font: inherit; font-size: 12px; cursor: pointer; }
.dv-body .copy-btn:hover { color: #fff; border-color: rgba(255,255,255,.4); }
.dv-body .copy-btn.copied { color: #86efac; border-color: #86efac; }
.dv-body pre { margin: 0; padding: 14px 16px; overflow-x: auto; font-family: var(--mono, monospace); font-size: 13.5px; line-height: 1.65; tab-size: 2; }
.dv-body pre code { padding: 0; background: none; border: 0; color: inherit; font-size: inherit; }
.dv-body li > pre { margin: 10px 0; background: var(--dv-code-bg); color: var(--dv-code-fg); border-radius: var(--radius, 6px); }

/* tables scroll sideways on a narrow screen instead of breaking the page */
.dv-body .table { margin: 0 0 20px; overflow-x: auto; border: 1px solid var(--dv-line); border-radius: var(--radius-lg, 8px); }
.dv-body table { width: 100%; border-collapse: collapse; font-size: 14.5px; }
.dv-body th, .dv-body td { padding: 9px 14px; text-align: start; vertical-align: top; border-bottom: 1px solid var(--dv-line); }
.dv-body th { font-weight: 600; background: var(--dv-soft); white-space: nowrap; }
.dv-body tr:last-child td { border-bottom: 0; }
.dv-body td code { white-space: nowrap; }
.dv-body td:first-child { min-width: 9em; }

.dv-body blockquote { margin: 0 0 16px; padding: 4px 16px; color: var(--dv-muted); border-inline-start: 3px solid var(--dv-line); }

/* callouts: markdown makes <aside class="callout callout-note|tip|warning|danger|important"> */
.dv .callout { --c: #2563eb; margin: 0 0 18px; padding: 12px 16px; background: color-mix(in srgb, var(--c) 8%, transparent); border: 1px solid color-mix(in srgb, var(--c) 28%, transparent); border-inline-start: 4px solid var(--c); border-radius: var(--radius-lg, 8px); }
.dv .callout-tip { --c: #059669; }
.dv .callout-warning { --c: #d97706; }
.dv .callout-danger { --c: #dc2626; }
.dv .callout-important { --c: #7c3aed; }
.dv .callout p { margin: 0; font-size: 15px; line-height: 1.6; }
.dv .callout p + p { margin-top: 4px; }
.dv .callout-title { font-weight: 650; font-size: 13px !important; letter-spacing: .04em; text-transform: uppercase; color: var(--c); }

/* previous / next */
.dv-pager { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 64px; padding-top: 24px; border-top: 1px solid var(--dv-line); }
.dv-pager a { display: flex; flex-direction: column; gap: 2px; padding: 14px 16px; text-decoration: none; color: var(--dv-text); border: 1px solid var(--dv-line); border-radius: var(--radius-lg, 8px); }
.dv-pager a:hover { border-color: var(--dv-muted); }
.dv-pager small { font-size: 12px; color: var(--dv-muted); }
.dv-pager span { font-weight: 600; }
.dv-pager .next { text-align: end; grid-column: 2; }

/* loading */
.dv-skeleton div { height: 14px; margin-bottom: 12px; background: var(--dv-soft); border-radius: 6px; animation: dv-pulse 1.2s ease-in-out infinite; }
.dv-skeleton .a { width: 42%; height: 34px; margin-bottom: 24px; }
.dv-skeleton .b.short { width: 60%; }
.dv-skeleton .c { height: 120px; margin-top: 20px; }
@keyframes dv-pulse { 50% { opacity: .45; } }

/* search window */
.dv-modal { position: fixed; inset: 0; z-index: 80; display: flex; align-items: flex-start; justify-content: center; padding: 12vh 16px 16px; background: rgba(9,9,11,.55); }
.dv-modal-box { width: 100%; max-width: 620px; max-height: 70vh; display: flex; flex-direction: column; overflow: hidden; background: var(--background, #fff); color: var(--dv-text); border: 1px solid var(--dv-line); border-radius: 12px; box-shadow: 0 24px 60px rgba(0,0,0,.35); }
.dv-modal-in { display: flex; align-items: center; gap: 10px; padding: 0 14px; border-bottom: 1px solid var(--dv-line); color: var(--dv-muted); }
.dv-modal-in input { flex: 1; height: 52px; background: transparent; color: var(--dv-text); border: 0; outline: 0; font: inherit; font-size: 16px; }
.dv-results { list-style: none; margin: 0; padding: 8px; overflow: auto; }
.dv-results li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; padding: 9px 12px; border-radius: var(--radius, 6px); cursor: pointer; }
.dv-results li.on { background: var(--dv-soft); }
.dv-results .r-title { font-weight: 600; }
.dv-results .r-where { font-size: 12px; color: var(--dv-muted); }
.dv-results .r-snippet { flex-basis: 100%; font-size: 13px; color: var(--dv-muted); }
.dv-results .none { color: var(--dv-muted); cursor: default; }
.dv-modal-foot { display: flex; gap: 16px; padding: 9px 14px; border-top: 1px solid var(--dv-line); font-size: 12px; color: var(--dv-muted); }

.dv-top { position: fixed; inset-inline-end: 20px; bottom: 76px;   /* above the DevTools button (bottom right, `kreftjs dev` only) */ z-index: 40; display: grid; place-items: center; width: 40px; height: 40px; background: var(--background, #fff); color: var(--dv-text); border: 1px solid var(--dv-line); border-radius: 50%; cursor: pointer; opacity: 0; pointer-events: none; transform: translateY(8px); transition: opacity .2s, transform .2s; }
.dv-top.show { opacity: 1; pointer-events: auto; transform: none; }

/* narrow screens */
.dv-bar { display: none; }
.dv-overlay { display: none; }
@media (max-width: 1180px) {
  .dv-grid { grid-template-columns: 240px minmax(0, 1fr); }
  .dv-toc { display: none; }
}
@media (max-width: 860px) {
  .dv-grid { display: block; }
  .dv-bar { position: sticky; top: var(--dv-bar); z-index: 30; display: flex; align-items: center; gap: 10px; height: 46px; margin: 0 -16px; padding: 0 16px; background: var(--background, #fff); border-bottom: 1px solid var(--dv-line); }
  .dv-bar-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14px; font-weight: 600; text-align: center; }
  .dv-btn { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 10px; background: transparent; color: var(--dv-text); border: 1px solid var(--dv-line); border-radius: var(--radius, 6px); font: inherit; font-size: 13px; cursor: pointer; }
  .dv-side { position: fixed; inset: 0 auto 0 0; z-index: 70; width: min(86vw, 320px); max-height: none; padding: 16px; background: var(--background, #fff); border-inline-end: 1px solid var(--dv-line); transform: translateX(-102%); transition: transform .22s ease; }
  .dv-side.open { transform: none; }
  .dv-overlay { display: block; position: fixed; inset: 0; z-index: 65; background: rgba(9,9,11,.5); }
  .dv-main { padding-top: 16px; }
  .dv-time { display: none; }
  .dv-body .doc-heading { scroll-margin-top: calc(var(--dv-bar) + 66px); }
  .dv-body .doc-h2 { font-size: 26px; }
  .dv-body .heading-anchor { display: none; }
  .dv-pager { grid-template-columns: 1fr; }
  .dv-pager .next { grid-column: 1; }
}
@media (prefers-reduced-motion: reduce) {
  .dv-side, .dv-top, .dv-progress div { transition: none; }
  .dv-skeleton div { animation: none; }
}
</style>
