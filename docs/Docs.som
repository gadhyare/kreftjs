<!-- Som.js Documentation Viewer (docs/Docs.som)
     A smart, interactive documentation viewer with live full-text search,
     scroll-spy active section indicator, sticky reading progress header,
     1-click code copy, keyboard shortcuts, and floating goTop button. -->
import { markdown } from './markdown.js'

state filter = ''
state current = ''
state currentTitle = 'Som.js Documentation'
state currentSubTitle = ''
state scrollPct = 0
state showTop = false
state copiedSection = false
state mobileOpen = false
state article = null
state searchInput = null

// Load and parse README.en.md with deep section indexing and metrics
load doc = (async () => {
  for (const path of ['docs/README.en.md', '../docs/README.en.md']) {
    const res = await fetch(new URL(path, document.baseURI))
    if (!res.ok || /html/.test(res.headers.get('content-type') || '')) continue
    const raw = (await res.text())
      .replace(/^🌐.*$/m, '')
      .replace(/^## Contents\s*$[\s\S]*?^---\s*$/m, '')
    return markdown(raw)
  }
  throw new Error('The documentation file was not found (docs/README.en.md).')
})()

// TOC and Smart Section Filtering
derive toc = !doc.data ? [] : doc.data.toc.filter((t) => t.id !== 'contents')

derive shown = (() => {
  if (!doc.data) return []
  const q = filter.trim().toLowerCase()
  if (!q) return doc.data.toc.filter((t) => t.id !== 'contents')
  
  // Smart multi-layer search: matches titles, keywords, and section contents
  const results = []
  const seen = new Set()

  // Layer 1: Title matches (highest priority)
  for (const item of doc.data.toc) {
    if (item.id === 'contents') continue
    if (item.text.toLowerCase().includes(q)) {
      results.push({ ...item, matchType: 'title' })
      seen.add(item.id)
    }
  }

  // Layer 2: Deep content & code snippets search
  if (doc.data.sections) {
    for (const sec of doc.data.sections) {
      if (sec.id === 'contents' || seen.has(sec.id)) continue
      if (sec.content && sec.content.toLowerCase().includes(q)) {
        results.push({ ...sec, matchType: 'content' })
        seen.add(sec.id)
      }
    }
  }

  return results
})()

derive activeTitle = (() => {
  if (currentTitle) return currentTitle
  if (!doc.data || !current) return 'Overview'
  const match = doc.data.toc.find((t) => t.id === current)
  return match ? match.text : 'Overview'
})()

// Navigate smoothly to target section
action go(id) {
  const el = article && article.querySelector('[id="' + id.replace(/["\\]/g, '\\$&') + '"]')
  if (!el) return
  el.scrollIntoView({ behavior: 'smooth', block: 'start' })
  current = id
  
  if (doc.data && doc.data.toc) {
    const match = doc.data.toc.find((t) => t.id === id)
    if (match) {
      if (match.level === 3 && match.parentTitle) {
        currentTitle = match.parentTitle
        currentSubTitle = match.text
      } else {
        currentTitle = match.text
        currentSubTitle = ''
      }
    }
  }
  
  mobileOpen = false
  if (typeof history !== 'undefined' && history.replaceState) {
    history.replaceState(null, '', '#' + id)
  }
}

// Floating back-to-top action
action goTop() {
  window.scrollTo({ top: 0, behavior: 'smooth' })
  current = ''
  currentTitle = 'Introduction'
  currentSubTitle = ''
  if (typeof history !== 'undefined' && history.replaceState) {
    history.replaceState(null, '', window.location.pathname)
  }
}

// Reset search filter
action clearFilter() {
  filter = ''
  if (searchInput) searchInput.focus()
}

// Toggle mobile navigation drawer
action toggleMobile() {
  mobileOpen = !mobileOpen
}

// Copy permalink to active section
action copyCurrentLink() {
  if (typeof window === 'undefined') return
  const url = window.location.origin + window.location.pathname + (current ? '#' + current : '')
  navigator.clipboard.writeText(url).then(() => {
    copiedSection = true
    setTimeout(() => { copiedSection = false }, 2000)
  })
}

// Event delegation for links and interactive 1-click code copying
action handleArticleClick(e) {
  const target = e.target

  // 1. Copy code block handler
  const copyBtn = target.closest('.copy-btn')
  if (copyBtn) {
    e.preventDefault()
    e.stopPropagation()
    const box = copyBtn.closest('.code-box')
    const codeEl = box && box.querySelector('code')
    if (codeEl) {
      const codeText = codeEl.innerText || codeEl.textContent || ''
      navigator.clipboard.writeText(codeText).then(() => {
        const orig = copyBtn.textContent
        copyBtn.textContent = '✓ Copied!'
        copyBtn.classList.add('copied')
        setTimeout(() => {
          copyBtn.textContent = orig
          copyBtn.classList.remove('copied')
        }, 2000)
      })
    }
    return
  }

  // 2. Section anchor & in-page link navigation
  const a = target.closest('a')
  if (!a) return
  const href = a.getAttribute('href') || ''
  if (href.startsWith('#')) {
    e.preventDefault()
    go(decodeURIComponent(href.slice(1)))
  }
}

// Scroll spy & reading progress synchronization
action syncScroll() {
  if (typeof window === 'undefined') return
  const docElem = document.documentElement
  const scrollTop = window.scrollY || docElem.scrollTop || 0
  const maxScroll = (docElem.scrollHeight - window.innerHeight) || 1
  scrollPct = Math.min(100, Math.max(0, Math.round((scrollTop / maxScroll) * 100)))
  showTop = scrollTop > 320

  // Detect active heading in viewport
  if (!article) return
  const headings = article.querySelectorAll('h2[id], h3[id]')
  let activeId = ''
  let activeText = ''
  let activeSub = ''

  for (let i = 0; i < headings.length; i++) {
    const rect = headings[i].getBoundingClientRect()
    // Trigger when heading passes 120px from top
    if (rect.top <= 140) {
      activeId = headings[i].id
      const titleSpan = headings[i].querySelector('.heading-title')
      const text = titleSpan ? titleSpan.textContent.trim() : headings[i].textContent.replace(/^#\s*/, '').trim()
      
      if (headings[i].tagName.toLowerCase() === 'h3') {
        activeSub = text
      } else {
        activeText = text
        activeSub = ''
      }
    } else {
      break
    }
  }

  if (activeId && activeId !== current) {
    current = activeId
    if (activeText) currentTitle = activeText
    if (activeSub) currentSubTitle = activeSub
  }
}

// Lifecycle Hooks: attach event listeners and hotkeys
on ready {
  const onScroll = () => syncScroll()
  const onKeyDown = (e) => {
    // Keyboard shortcut: Press "/" or "Ctrl+K" / "Cmd+K" to focus search
    const isSlash = e.key === '/'
    const isCmdK = (e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k'
    if (isSlash || isCmdK) {
      const tag = (document.activeElement && document.activeElement.tagName) || ''
      if (tag === 'INPUT' || tag === 'TEXTAREA' || document.activeElement.isContentEditable) return
      e.preventDefault()
      if (searchInput) {
        searchInput.focus()
        searchInput.select()
      }
    } else if (e.key === 'Escape' && filter) {
      clearFilter()
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true })
  window.addEventListener('keydown', onKeyDown)
  syncScroll()

  // Handle direct hash navigation on page load
  if (window.location.hash) {
    setTimeout(() => {
      const hash = decodeURIComponent(window.location.hash.slice(1))
      go(hash)
    }, 250)
  }
}

<view>
  <div class="docs-wrapper" dir="ltr">
    <!-- Sticky Smart Reading Topbar -->
    <header class="docs-topbar">
      <div class="topbar-inner">
        <div class="topbar-left">
          <button class="mobile-toggle-btn" type="button" @click="toggleMobile" aria-label="Toggle Navigation">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
            <span>Index</span>
          </button>

          <div class="section-indicator">
            <span class="indicator-icon">📌</span>
            <div class="indicator-text">
              <span class="active-section-name">{activeTitle}</span>
              <span s-if="currentSubTitle" class="active-subsection-name">› {currentSubTitle}</span>
            </div>
          </div>
        </div>

        <div class="topbar-right">
          <span class="read-stats" s-if="doc.data && doc.data.stats">
            <span class="stats-badge">~{doc.data.stats.readTimeMinutes} min read</span>
            <span class="stats-progress">{scrollPct}%</span>
          </span>

          <button class="action-pill-btn" type="button" @click="copyCurrentLink" title="Copy section link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
            <span>{copiedSection ? 'Link Copied!' : 'Copy Link'}</span>
          </button>
        </div>
      </div>

      <!-- Real-time dynamic reading progress bar -->
      <div class="progress-track">
        <div class="progress-bar-fill" style={'width: ' + scrollPct + '%'}></div>
      </div>
    </header>

    <div class="docs-layout">
      <!-- Sidebar Navigation & Live Search -->
      <aside class={'docs-sidebar' + (mobileOpen ? ' mobile-active' : '')}>
        <div class="sidebar-header">
          <div class="search-box">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              s-model="filter"
              s-ref="searchInput"
              placeholder="Search topics (Press /)"
              aria-label="Search documentation"
              autocomplete="off"
              spellcheck="false"
            >
            <button s-if="filter" type="button" class="clear-search-btn" @click="clearFilter" aria-label="Clear search">×</button>
            <kbd s-else class="kbd-pill">/</kbd>
          </div>

          <div class="search-meta">
            <span s-if="!filter" class="meta-count">{toc.length} Sections Available</span>
            <span s-else class="meta-count highlight">Found {shown.length} {shown.length === 1 ? 'result' : 'results'}</span>
            <button s-if="filter" type="button" class="meta-reset-link" @click="clearFilter">Reset</button>
          </div>
        </div>

        <nav class="sidebar-nav">
          <ul class="toc-tree">
            {for t in shown key t.id}
              <li class={'toc-item l' + t.level + (current === t.id ? ' is-active' : '')}>
                <a href={'#' + t.id} @click.prevent="go(t.id)">
                  <span class="toc-badge" s-if="t.level === 2">§</span>
                  <span class="toc-bullet" s-else>•</span>
                  <span class="toc-label">{t.text}</span>
                  <span s-if="t.matchType === 'content'" class="match-chip">text match</span>
                </a>
              </li>
            {empty}
              <li class="empty-results">
                <div class="empty-icon">🔍</div>
                <div class="empty-title">No matching topics</div>
                <div class="empty-desc">No section matches "<strong>{filter}</strong>". Try searching for <code>router</code>, <code>database</code>, <code>redis</code>, or <code>actions</code>.</div>
                <button type="button" class="btn-clear-search" @click="clearFilter">Clear Filter</button>
              </li>
            {/for}
          </ul>
        </nav>
      </aside>

      <!-- Main Documentation Article -->
      <main class="docs-main">
        <article class="docs-article" s-ref="article" @click="handleArticleClick($event)">
          <div s-if="doc.loading" class="docs-loading-skeleton">
            <div class="skeleton-shimmer line-title"></div>
            <div class="skeleton-shimmer line-para"></div>
            <div class="skeleton-shimmer line-para short"></div>
            <div class="skeleton-shimmer line-code"></div>
            <div class="skeleton-shimmer line-para"></div>
          </div>

          <div s-elif="doc.error" class="docs-error-card">
            <div class="error-badge">Documentation Load Error</div>
            <p>{doc.error.message}</p>
            <button type="button" class="btn-retry" @click="window.location.reload()">Reload Page</button>
          </div>

          <div s-else class="markdown-body" s-html="doc.data.html"></div>
        </article>
      </main>
    </div>

    <!-- Floating Go-To-Top Button with live scroll percentage ring -->
    <button
      type="button"
      class={'go-top-btn' + (showTop ? ' is-visible' : '')}
      @click="goTop"
      aria-label="Back to top"
      title="Back to top"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="19" x2="12" y2="5"></line>
        <polyline points="5 12 12 5 19 12"></polyline>
      </svg>
      <span class="go-top-text">Top</span>
      <span class="go-top-pct">{scrollPct}%</span>
    </button>
  </div>
</view>

<style scoped>
/* Som.js Documentation Styles — Modern, Glassmorphic, High-Contrast */
.docs-wrapper {
  color: var(--foreground);
  min-height: 100vh;
  position: relative;
}

/* 1. Sticky Smart Reading Topbar */
.docs-topbar {
  position: sticky;
  top: 0;
  z-index: 40;
  background: var(--background);
  background: color-mix(in srgb, var(--background) 88%, transparent);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--border);
  margin: 0 -32px 28px -32px;
  padding: 10px 32px 0 32px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
}

.topbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 1220px;
  margin: 0 auto;
  padding-bottom: 10px;
  gap: 16px;
}

.topbar-left {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.mobile-toggle-btn {
  display: none;
  align-items: center;
  gap: 6px;
  background: var(--accent);
  color: var(--foreground);
  border: 1px solid var(--border);
  padding: 6px 12px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  border-radius: 6px;
}

.section-indicator {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.indicator-icon {
  font-size: 15px;
  flex-shrink: 0;
}

.indicator-text {
  display: flex;
  align-items: center;
  gap: 6px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.active-section-name {
  font-size: 14px;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--foreground);
  overflow: hidden;
  text-overflow: ellipsis;
}

.active-subsection-name {
  font-size: 13px;
  color: var(--muted);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

.read-stats {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--muted);
}

.stats-badge {
  background: var(--accent);
  border: 1px solid var(--border);
  padding: 3px 8px;
  border-radius: 4px;
  font-weight: 500;
}

.stats-progress {
  font-weight: 700;
  color: var(--foreground);
  min-width: 34px;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.action-pill-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--accent);
  color: var(--foreground);
  border: 1px solid var(--border);
  padding: 5px 11px;
  font-size: 12px;
  font-weight: 600;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.15s ease;
}

.action-pill-btn:hover {
  background: var(--border);
  transform: translateY(-1px);
}

/* Dynamic Reading Progress Bar */
.progress-track {
  width: calc(100% + 64px);
  margin-left: -32px;
  height: 2px;
  background: transparent;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: var(--foreground);
  transition: width 0.1s linear;
}

/* 2. Grid Layout */
.docs-layout {
  display: grid;
  grid-template-columns: 290px minmax(0, 1fr);
  gap: 52px;
  align-items: start;
}

/* 3. Sidebar */
.docs-sidebar {
  position: sticky;
  top: 72px;
  max-height: calc(100vh - 86px);
  display: flex;
  flex-direction: column;
  border-inline-end: 1px solid var(--border);
  padding-inline-end: 24px;
  overflow: hidden;
}

.sidebar-header {
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 12px;
  flex-shrink: 0;
}

.search-box {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
}

.search-box input {
  width: 100%;
  padding: 9px 36px 9px 34px;
  font-size: 13.5px;
  background: var(--accent);
  color: var(--foreground);
  border: 1px solid var(--border);
  border-radius: 8px;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.search-box input:focus {
  border-color: var(--foreground);
  box-shadow: 0 0 0 2px rgba(125, 125, 125, 0.15);
}

.search-icon {
  position: absolute;
  left: 10px;
  color: var(--muted);
  pointer-events: none;
}

.clear-search-btn {
  position: absolute;
  right: 8px;
  background: none;
  border: none;
  color: var(--muted);
  font-size: 18px;
  line-height: 1;
  padding: 4px;
  cursor: pointer;
}

.clear-search-btn:hover {
  color: var(--foreground);
}

.kbd-pill {
  position: absolute;
  right: 10px;
  font-family: var(--mono, monospace);
  font-size: 11px;
  background: var(--background);
  color: var(--muted);
  border: 1px solid var(--border);
  padding: 2px 6px;
  border-radius: 4px;
  pointer-events: none;
}

.search-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8px;
  font-size: 11.5px;
  color: var(--muted);
}

.meta-count.highlight {
  color: var(--foreground);
  font-weight: 600;
}

.meta-reset-link {
  background: none;
  border: none;
  color: var(--foreground);
  text-decoration: underline;
  cursor: pointer;
  font-size: 11px;
  padding: 0;
}

.sidebar-nav {
  overflow-y: auto;
  flex: 1;
  padding-bottom: 24px;
  padding-inline-end: 4px;
}

.sidebar-nav::-webkit-scrollbar {
  width: 4px;
}

.sidebar-nav::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 4px;
}

.toc-tree {
  list-style: none;
  margin: 0;
  padding: 0;
}

.toc-item {
  margin: 2px 0;
}

.toc-item a {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 10px;
  color: var(--muted);
  text-decoration: none;
  font-size: 13.5px;
  border-radius: 6px;
  line-height: 1.4;
  transition: all 0.15s ease;
}

.toc-item a:hover {
  color: var(--foreground);
  background: var(--accent);
}

.toc-item.is-active a {
  color: var(--foreground);
  font-weight: 700;
  background: var(--accent);
  box-shadow: inset 3px 0 0 var(--foreground);
}

.toc-item.l3 a {
  padding-inline-start: 24px;
  font-size: 12.5px;
}

.toc-badge {
  font-size: 12px;
  color: var(--muted);
  opacity: 0.7;
}

.toc-bullet {
  font-size: 10px;
  color: var(--muted);
}

.toc-label {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.match-chip {
  font-size: 10px;
  background: var(--border);
  color: var(--muted);
  padding: 1px 5px;
  border-radius: 3px;
  text-transform: uppercase;
  font-weight: 600;
}

.empty-results {
  padding: 24px 12px;
  text-align: center;
}

.empty-icon {
  font-size: 26px;
  margin-bottom: 8px;
}

.empty-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--foreground);
  margin-bottom: 4px;
}

.empty-desc {
  font-size: 12px;
  color: var(--muted);
  line-height: 1.5;
  margin-bottom: 12px;
}

.btn-clear-search {
  background: var(--accent);
  color: var(--foreground);
  border: 1px solid var(--border);
  padding: 5px 12px;
  font-size: 12px;
  border-radius: 4px;
  cursor: pointer;
  font-weight: 600;
}

/* 4. Main Article Container */
.docs-main {
  min-width: 0;
  max-width: 840px;
}

.docs-article {
  min-width: 0;
  line-height: 1.75;
  font-size: 15.5px;
  color: var(--foreground);
}

/* Skeletons */
.docs-loading-skeleton {
  padding: 24px 0;
}

.skeleton-shimmer {
  background: linear-gradient(90deg, var(--accent) 25%, var(--border) 50%, var(--accent) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 6px;
  margin-bottom: 16px;
}

.line-title { height: 38px; width: 60%; margin-bottom: 24px; }
.line-para { height: 16px; width: 100%; }
.line-para.short { width: 75%; }
.line-code { height: 120px; width: 100%; margin: 24px 0; }

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.docs-error-card {
  border: 1px solid var(--destructive, #ef4444);
  background: color-mix(in srgb, var(--destructive, #ef4444) 8%, var(--background));
  padding: 24px;
  border-radius: 8px;
}

.error-badge {
  font-weight: 700;
  color: var(--destructive, #ef4444);
  font-size: 16px;
  margin-bottom: 8px;
}

.btn-retry {
  margin-top: 12px;
  background: var(--foreground);
  color: var(--background);
  border: none;
  padding: 6px 14px;
  border-radius: 6px;
  font-weight: 600;
  cursor: pointer;
}

/* 5. Deep Article Styling */
.docs-article :deep(h1) {
  font-size: 38px;
  letter-spacing: -0.04em;
  margin: 0 0 20px;
