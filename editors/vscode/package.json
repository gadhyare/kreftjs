{
  "name": "kreftjs",
  "displayName": "Kreft (.kreftjs files)",
  "description": "Colors, brackets, formatting and snippets for Kreft .kreftjs component files (and .kreft and .som files from older projects).",
  "version": "2.3.0",
  "publisher": "kreft",
  "license": "MIT",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Snippets"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:kreftjs"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kreftjs",
        "aliases": [
          "Kreft",
          "kreftjs"
        ],
        "extensions": [
          ".kreftjs",
          ".kreft",
          ".som"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kreftjs",
        "scopeName": "source.kreftjs",
        "path": "./syntaxes/kreftjs.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.html": "html",
          "source.css": "css",
          "meta.embedded.expression.kreftjs": "javascript",
          "meta.embedded.block.javascript": "javascript",
          "source.js": "javascript"
        }
      }
    ],
    "snippets": [
      {
        "language": "kreftjs",
        "path": "./snippets/kreftjs.json"
      }
    ]
  }
}
