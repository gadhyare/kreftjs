{
  "name": "kreftjs",
  "displayName": "Kreft (.kreft files)",
  "description": "Colors, brackets, formatting and snippets for Kreft .kreft component files (and .kreftjs files from the 0.0.x betas).",
  "version": "2.3.0",
  "publisher": "kreft",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/gadhyare/somjs.git"
  },
  "homepage": "https://github.com/gadhyare/somjs#readme",
  "bugs": {
    "url": "https://github.com/gadhyare/somjs/issues"
  },
  "galleryBanner": {
    "color": "#1e1b4b",
    "theme": "dark"
  },
  "keywords": [
    "kreft",
    "kreftjs",
    ".kreft",
    "syntax highlighting",
    "snippets",
    "formatter",
    "framework",
    "laravel"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Snippets"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:kreftjs"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kreftjs",
        "aliases": [
          "Kreft",
          "kreftjs"
        ],
        "extensions": [
          ".kreft",
          ".kreftjs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kreftjs",
        "scopeName": "source.kreftjs",
        "path": "./syntaxes/kreftjs.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.html": "html",
          "source.css": "css",
          "meta.embedded.expression.kreftjs": "javascript",
          "meta.embedded.block.javascript": "javascript",
          "source.js": "javascript"
        }
      }
    ],
    "snippets": [
      {
        "language": "kreftjs",
        "path": "./snippets/kreftjs.json"
      }
    ]
  }
}
