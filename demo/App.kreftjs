<!-- The app: the page for the current route, inside its layout (layouts/main.kreftjs or layouts/plain.kreftjs), and a toast -->
state toast = ''
let timer

on ready {
  // any component can send a toast through the bus
  bus.on('toast', (message) => {
    toast = message
    clearTimeout(timer)
    timer = setTimeout(() => (toast = ''), 2000)
  })
}

<view>
  <kreft-view k-animate.after="page"></kreft-view>
  <div class="toast" k-if="toast" k-animate="slide" role="status">{toast}</div>
</view>

<style>
.toast { position: fixed; bottom: 20px; right: 20px; z-index: 20; background: var(--primary); color: var(--primary-foreground); padding: 12px 16px; font-size: 14px; font-weight: 500; border: 1px solid var(--primary); }
</style>
