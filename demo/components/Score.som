<!-- Shows a rating as text; used to switch components with <som-component :is> -->
prop modelValue = 0

<view>
  <p class="score">{modelValue} / 5 · {modelValue >= 4 ? 'Great' : modelValue >= 2 ? 'Fine' : 'Poor'}</p>
</view>

<style scoped>
.score { font-size: 22px; font-weight: 700; margin: 0; }
</style>
