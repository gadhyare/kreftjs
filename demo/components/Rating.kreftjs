<!-- A star rating that works with k-model: <rating k-model="stars"></rating> -->
prop modelValue = 0
prop max = 5
event update:modelValue

<view>
  <span class="stars" role="group" aria-label="Rating">
    {for n in max}
      <button type="button" class={n <= modelValue ? 'on' : ''} @click="send('update:modelValue', n)" aria-label="{n} of {max}">★</button>
    {/for}
  </span>
</view>

<style scoped>
.stars { display: inline-flex; gap: 2px; }
button { border: none; background: none; font-size: 26px; color: var(--input); padding: 2px; min-width: 32px; cursor: pointer; }
button.on { color: var(--ember); }
</style>
