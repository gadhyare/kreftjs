<!-- Shows a list of todos and tells the parent when one should be removed -->
prop items = []
event remove

<view>
  <ul>
    {for todo in items key todo.id}
      <li>
        <label>
          <input type="checkbox" s-model="todo.done">
          <span class={todo.done ? 'done' : ''}>{todo.text}</span>
        </label>
        <button @click="send('remove', todo.id)" aria-label="Remove">✕</button>
      </li>
    {empty}
      <li class="muted"><slot name="empty">No items</slot></li>
    {/for}
  </ul>
</view>

<style scoped>
ul { list-style: none; padding: 0; margin: 0; }
li { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--border); }
.done { text-decoration: line-through; color: var(--muted); }
button { border: none; background: none; }
</style>
