<!-- The bar at the top of both layouts. Recreated to match Image 1 & Image 3 -->
use cart
prop menu = false
prop open = false
event toggle

<view>
  <header class="bar">
    <div class="bar-inner">
      <button k-if="menu" class="ghost menu-button" @click="send('toggle')" aria-label="Menu" aria-expanded={open ? 'true' : 'false'}>
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2"/></svg>
      </button>
      <kreft-link to="/" class="brand"><img class="mark" src="logo-mark.svg" alt="" width="22" height="22">kreft</kreft-link>
      <nav class="top {menu ? 'hide-small' : ''}" aria-label="Main">
        <kreft-link to="/docs">Docs</kreft-link>
        <kreft-link to="/playground">Playground</kreft-link>
        <kreft-link to="/basics" class="nav-extra">Examples</kreft-link>
      </nav>
      <div class="end">
        <kreft-yield name="actions"></kreft-yield>
        <button class="icon-btn" @click="theme.toggle()" title={theme.dark ? 'Switch to light mode' : 'Switch to dark mode'} aria-label="Toggle theme">
          <svg k-if="theme.dark" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          <svg k-else width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <kreft-link to="/shop" class="cart-btn">Cart <span class="count">{cart.count}</span></kreft-link>
      </div>
    </div>
  </header>
</view>

<style scoped>
.bar {
  position: sticky;
  top: 0;
  z-index: 50;
  height: 60px;
  background: color-mix(in srgb, var(--background) 88%, transparent);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  font-family: var(--font, system-ui, -apple-system, sans-serif);
}
.bar-inner {
  display: flex;
  align-items: center;
  width: 100%;
  max-width: calc(var(--container) + var(--container-pad) * 2);
  height: 100%;
  margin: 0 auto;
  padding: 0 var(--container-pad, 28px);
  box-sizing: border-box;
}
.brand {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  font-weight: 700;
  font-size: 16px;
  letter-spacing: -0.025em;
  color: var(--foreground);
  text-decoration: none;
  margin-right: 48px;
}
.mark {
  width: 22px;
  height: 22px;
}
.top {
  display: flex;
  align-items: center;
  gap: 40px;
  flex: 1;
}
.top a {
  color: var(--muted);
  text-decoration: none;
  font-family: var(--font, system-ui, -apple-system, sans-serif);
  font-size: 15px;
  font-weight: 500;
  letter-spacing: -0.01em;
  padding: 6px 0;
  transition: color 0.15s ease;
}
.top a:hover {
  color: var(--foreground);
}
.top a.kreft-link-active {
  color: var(--foreground);
  font-weight: 600;
}
.end {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-left: auto;
}
.count {
  font-variant-numeric: tabular-nums;
  font-weight: 600;
  color: inherit;
}
.icon-btn {
  width: 36px;
  height: 36px;
  padding: 0;
  color: var(--muted);
  background: transparent;
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  cursor: pointer;
  transition: color 0.15s ease, background 0.15s ease;
}
.icon-btn:hover {
  color: var(--foreground);
  background: var(--accent);
}
.cart-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--card);
  color: var(--foreground);
  border: 1px solid var(--border);
  padding: 7px 16px;
  border-radius: 8px;
  font-size: 13.5px;
  font-weight: 500;
  text-decoration: none;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  transition: all 0.15s ease;
}
.cart-btn:hover {
  background: var(--accent);
}
.menu-button {
  display: none;
  width: 36px;
  padding: 0;
  background: transparent;
  border: none;
  color: var(--foreground);
}
@media (max-width: 760px) {
  .bar-inner { padding: 0 16px; }
  .brand { margin-right: 20px; }
  .menu-button { display: inline-flex; }
  .top.hide-small { display: none; }
  .top { gap: 18px; }
}
/* three links and the buttons must fit a small phone: tighter, and Examples leaves the bar (it is in the footer and the menu) */
@media (max-width: 560px) {
  .brand { margin-right: 12px; }
  .top { gap: 12px; font-size: 13px; }
}
@media (max-width: 440px) {
  .top .nav-extra { display: none; }
}
@media (max-width: 360px) {
  .bar-inner { padding: 0 10px; }
  .brand { margin-right: 6px; gap: 6px; font-size: 15px; }
  .top { gap: 8px; }
  .top a { font-size: 12.5px; }
  .end { gap: 2px; }
  .icon-btn { width: 32px; }
  .cart-btn { padding: 7px 10px; gap: 4px; font-size: 13px; }
}
</style>
