<!-- The bar at the top of both layouts. A page can add buttons to it with <som-section name="actions"> -->
use cart
prop menu = false
prop open = false
event toggle

<view>
  <header class="bar">
    <button s-if="menu" class="ghost menu-button" @click="send('toggle')" aria-label="Menu" aria-expanded={open ? 'true' : 'false'}>
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2"/></svg>
    </button>
    <som-link to="/" class="brand"><span class="mark" aria-hidden="true"></span>som.js</som-link>
    <nav class="top {menu ? 'hide-small' : ''}" aria-label="Main">
      <som-link to="/docs">Docs</som-link>
      <som-link to="/basics">Examples</som-link>
      <som-link to="/layouts">Layouts</som-link>
    </nav>
    <div class="end">
      <som-yield name="actions"></som-yield>
      <button class="ghost icon-btn" @click="theme.toggle()" title={theme.dark ? 'Switch to light mode' : 'Switch to dark mode'} aria-label="Toggle theme">
        <svg s-if="theme.dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg s-else width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <som-link to="/shop" class="btn sm">Cart <span class="count">{cart.count}</span></som-link>
    </div>
  </header>
</view>

<style scoped>
.bar { position: sticky; top: 0; z-index: 10; height: 56px; display: flex; align-items: center; gap: 24px; padding: 0 24px; background: var(--background); border-bottom: 1px solid var(--border); }
.brand { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 16px; letter-spacing: -0.03em; color: var(--foreground); text-decoration: none; }
.mark { width: 14px; height: 14px; background: var(--primary); }
.top { display: flex; gap: 20px; flex: 1; }
.top a { color: var(--muted); text-decoration: none; font-size: 14px; font-weight: 500; }
.top a:hover, .top a.som-link-active { color: var(--foreground); }
.end { display: flex; align-items: center; gap: 8px; margin-left: auto; }
.count { font-variant-numeric: tabular-nums; color: var(--muted); }
.icon-btn { width: 32px; height: 32px; padding: 0; color: var(--foreground); display: inline-flex; align-items: center; justify-content: center; }
.menu-button { display: none; width: 36px; padding: 0; }
@media (max-width: 760px) {
  .bar { padding: 0 12px; gap: 12px; }
  .menu-button { display: inline-flex; }
  .top.hide-small { display: none; }
  .top { gap: 14px; }
}
</style>
