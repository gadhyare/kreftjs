<!-- a tab with something typed in it: with keep, the text is still there when you come back -->
state text = ''
state visits = 0

on show { visits++ }

<view>
  <div class="tab-body">
    <textarea k-model="text" rows="3" placeholder="Type something, switch tabs, come back…" aria-label="Note"></textarea>
    <p class="muted">Shown {visits} time{visits === 1 ? '' : 's'} · {text.length} letters</p>
  </div>
</view>

<style scoped>
textarea { width: 100%; font: inherit; padding: 8px; border: 1px solid var(--input); }
</style>
