    .preview-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }
    .preview-dot.red { background: #ef4444; }
    .preview-dot.yellow { background: #f59e0b; }
    .preview-dot.green { background: #10b981; }
    .preview-box-title {
      font-size: 12px;
      font-weight: 600;
      color: var(--muted);
      margin-left: 6px;
