<view>
  <div class="demo-docs-wrapper">
    <!-- TOP PROGRESS BAR -->
    <div class="demo-top-progress-track" aria-hidden="true">
      <div class="demo-top-progress-bar" style={'width: ' + progressPct + '%; opacity: ' + progressOpacity}></div>
    </div>

    <!-- TOP HEADER -->
    <header class="demo-docs-topbar">
      <div class="demo-topbar-left">
        <button class="sidebar-toggle-btn" @click="toggleSidebar" aria-label="Toggle Sidebar">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/></svg>
          <span>Sidebar</span>
        </button>
        <div class="demo-title-group">
          <h1>Docs Demo</h1>
          <span class="demo-badge-pill">Interactive Tabs</span>
        </div>
      </div>

      <!-- TOP HORIZONTAL TAB SWITCHER -->
      <nav class="demo-top-tabs" role="tablist" aria-label="Documentation Tabs">
        {for tab in tabs key tab.id}
          <button
            type="button"
            role="tab"
            aria-selected={activeTab === tab.id ? 'true' : 'false'}
            class={'demo-tab-btn' + (activeTab === tab.id ? ' is-active' : '')}
            @click="selectTab(tab.id)"
          >
            <span class="demo-tab-icon" k-html="tab.iconSvg"></span>
            <span class="demo-tab-title">{tab.label}</span>
            <span class="demo-tab-tag">{tab.badge}</span>
          </button>
        {/for}
      </nav>
    </header>

    <!-- 2-COLUMN LAYOUT -->
    <div class="demo-docs-layout">
      <!-- Mobile Backdrop -->
      <div k-if="!sidebarCollapsed" class="demo-docs-backdrop" @click="toggleSidebar" aria-hidden="true"></div>

      <!-- LEFT SIDEBAR: TAB LIST -->
      <aside class="demo-docs-sidebar" k-if="!sidebarCollapsed">
        <div class="demo-docs-mobile-header">
          <span>Documentation Tabs</span>
          <button class="demo-docs-close" @click="toggleSidebar" aria-label="Close sidebar">×</button>
        </div>

        <div class="demo-sidebar-heading">Navigation Tabs</div>
        <nav class="demo-sidebar-nav">
          <ul class="demo-sidebar-list">
            {for tab in tabs key tab.id}
              <li>
                <button
                  type="button"
                  class={'demo-sidebar-item' + (activeTab === tab.id ? ' is-active' : '')}
                  @click="selectTab(tab.id)"
                >
                  <span class="demo-item-icon" k-html="tab.iconSvg"></span>
                  <div class="demo-item-text">
                    <span class="demo-item-label">{tab.label}</span>
                    <span class="demo-item-desc">{tab.desc}</span>
                  </div>
                  <span class="demo-item-badge">{tab.badge}</span>
                </button>
              </li>
            {/for}
          </ul>
        </nav>

        <div class="demo-keyboard-hint">
          <span class="hint-label">Switch tabs:</span>
          <kbd class="demo-kbd">←</kbd> <kbd class="demo-kbd">→</kbd>
        </div>
      </aside>

      <!-- MAIN TAB CONTENT PANELS -->
      <main class="demo-docs-main">

        <!-- TAB 1: INTRODUCTION -->
        <div k-if="activeTab === 'intro'" class="demo-tab-panel tab-fade-slide">
          <div class="tab-panel-header">
            <div class="tab-panel-meta">
              <span class="meta-tag">Overview</span>
              <span class="meta-dot">·</span>
              <span class="meta-time">2 min read</span>
            </div>
            <h2>Introduction to Kreft</h2>
            <p class="tab-panel-lead">
              Kreft is a zero-dependency, full-stack reactive framework featuring its own component language, built-in SQL ORM, state management, and desktop packaging.
            </p>
          </div>

          <div class="demo-features-grid">
            <div class="demo-card">
              <div class="card-icon">⚡</div>
              <h3>0 Dependencies</h3>
              <p>Self-contained runtime with no external dependencies required for builds or server operations.</p>
            </div>
            <div class="demo-card">
              <div class="card-icon">🎯</div>
              <h3>Component Language</h3>
              <p>Native <code>.kreft</code> components with compiled reactivity, stores, directives, and scoped styling.</p>
            </div>
            <div class="demo-card">
              <div class="card-icon">🛡️</div>
              <h3>Built-in Security</h3>
              <p>AES-256-GCM encrypted cookies, CSRF protection, and session fixation safeguards out of the box.</p>
            </div>
          </div>

          <!-- Interactive Micro Demo -->
          <div class="interactive-preview-box">
            <div class="preview-box-header">
              <span class="preview-dot red"></span>
              <span class="preview-dot yellow"></span>
              <span class="preview-dot green"></span>
              <span class="preview-box-title">Live Reactivity Demo</span>
            </div>
            <div class="preview-box-body">
              <div class="counter-row">
                <span class="counter-label">Reactive Counter:</span>
                <span class="counter-val">{introCount}</span>
                <button type="button" class="btn-demo-action" @click="introCount++">+ Increment</button>
                <button type="button" class="btn-demo-action secondary" @click="introCount = 0">Reset</button>
              </div>
              <p class="counter-double">Derive Double: <strong>{introCount * 2}</strong> · Updates instantaneously with 0 lag.</p>
            </div>
          </div>
        </div>

        <!-- TAB 2: SETUP & INSTALLATION -->
        <div k-elif="activeTab === 'setup'" class="demo-tab-panel tab-fade-slide">
          <div class="tab-panel-header">
            <div class="tab-panel-meta">
              <span class="meta-tag">Quick Start</span>
              <span class="meta-dot">·</span>
              <span class="meta-time">30 seconds</span>
            </div>
            <h2>Setup & Quick Installation</h2>
            <p class="tab-panel-lead">
              Spin up a production-ready application in seconds. No complex Webpack or Babel configurations needed.
            </p>
          </div>

          <div class="steps-flow">
            <div class="step-card">
              <div class="step-badge">1</div>
              <div class="step-info">
                <h3>Create New Application</h3>
                <p>Run the interactive initialization command in your terminal:</p>
                <div class="code-snippet-box">
                  <code>npm create kreftjs@latest my-app</code>
                  <button type="button" class="btn-copy" @click="copySnippet('npm create kreftjs@latest my-app')">{copied ? 'Copied!' : 'Copy'}</button>
                </div>
              </div>
            </div>

            <div class="step-card">
              <div class="step-badge">2</div>
              <div class="step-info">
                <h3>Start Development Server</h3>
                <p>Enter your application folder and run the built-in dev server:</p>
                <div class="code-snippet-box">
                  <code>cd my-app && npm run dev</code>
                  <button type="button" class="btn-copy" @click="copySnippet('cd my-app && npm run dev')">{copied ? 'Copied!' : 'Copy'}</button>
                </div>
              </div>
            </div>

            <div class="step-card">
              <div class="step-badge">3</div>
              <div class="step-info">
                <h3>Build for Production</h3>
                <p>Compile production assets directly with zero overhead:</p>
                <div class="code-snippet-box">
                  <code>npm run build</code>
                  <button type="button" class="btn-copy" @click="copySnippet('npm run build')">{copied ? 'Copied!' : 'Copy'}</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB 3: API REFERENCE -->
        <div k-elif="activeTab === 'api'" class="demo-tab-panel tab-fade-slide">
          <div class="tab-panel-header">
            <div class="tab-panel-meta">
              <span class="meta-tag">Reference</span>
              <span class="meta-dot">·</span>
              <span class="meta-time">v2.4 Core API</span>
            </div>
            <h2>API & Directives Reference</h2>
            <p class="tab-panel-lead">
              Essential primitives for state management, templates, server routing, and security.
            </p>
          </div>

          <!-- API Table -->
          <div class="api-table-wrapper">
            <table class="api-table">
              <thead>
                <tr>
                  <th>Directive / Primitive</th>
                  <th>Syntax Example</th>
                  <th>Description</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><code>state</code></td>
                  <td><code>state count = 0</code></td>
                  <td>Declares a local reactive signal property.</td>
                </tr>
                <tr>
                  <td><code>derive</code></td>
                  <td><code>derive double = count * 2</code></td>
                  <td>Cached computed value that auto-recalculates on dependency change.</td>
                </tr>
                <tr>
                  <td><code>action</code></td>
                  <td><code>action add() &#123; count++ &#125;</code></td>
                  <td>Bound handler method that updates reactive state.</td>
                </tr>
                <tr>
                  <td><code>k-model</code></td>
                  <td><code>&lt;input k-model="text" /&gt;</code></td>
                  <td>Two-way data binding for form inputs and components.</td>
                </tr>
                <tr>
                  <td><code>k-if / k-elif / k-else</code></td>
                  <td><code>&lt;div k-if="ready"&gt;...&lt;/div&gt;</code></td>
                  <td>Conditional DOM element rendering with animations.</td>
                </tr>
                <tr>
                  <td><code>Crypt</code></td>
                  <td><code>Crypt.encryptString(val)</code></td>
                  <td>AES-256-GCM authenticated string encryption with unique random IV.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- TAB 4: CORE ARCHITECTURE -->
        <div k-elif="activeTab === 'features'" class="demo-tab-panel tab-fade-slide">
          <div class="tab-panel-header">
            <div class="tab-panel-meta">
              <span class="meta-tag">Architecture</span>
              <span class="meta-dot">·</span>
              <span class="meta-time">Deep Dive</span>
            </div>
            <h2>Full-Stack Framework Architecture</h2>
            <p class="tab-panel-lead">
              Unified client and server runtime built for enterprise reliability and speed.
            </p>
          </div>

          <div class="architecture-grid">
            <div class="arch-card">
              <span class="arch-badge">Backend</span>
              <h3>Active Record ORM</h3>
              <p>Built-in migrations, query builder, and models supporting SQLite, MySQL, and PostgreSQL with connection pooling.</p>
            </div>
            <div class="arch-card">
              <span class="arch-badge">Security</span>
              <h3>Hardened Sessions</h3>
              <p>HttpOnly, SameSite=Lax/Strict, Secure cookie flags, and session fixation prevention on login and role elevation.</p>
            </div>
            <div class="arch-card">
              <span class="arch-badge">Frontend</span>
              <h3>Granular Reactivity</h3>
              <p>Signals-based update system that re-renders only modified DOM nodes rather than diffing entire virtual trees.</p>
            </div>
            <div class="arch-card">
              <span class="arch-badge">Tooling</span>
              <h3>Built-in MCP & DevTools</h3>
              <p>JSON-RPC 2.0 MCP server for AI pair programming, visual component inspector, and live reload.</p>
            </div>
          </div>
        </div>

        <!-- BOTTOM TAB PAGER (PREV / NEXT) -->
        <footer class="demo-tab-pager">
          <button
            type="button"
            class="pager-btn prev"
            k-if="prevTabInfo"
            @click="selectTab(prevTabInfo.id)"
          >
            <span class="pager-direction">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              Previous Tab
            </span>
            <span class="pager-label">{prevTabInfo.label}</span>
          </button>
          <div k-else class="pager-placeholder"></div>

          <button
            type="button"
            class="pager-btn next"
            k-if="nextTabInfo"
            @click="selectTab(nextTabInfo.id)"
          >
            <span class="pager-direction">
              Next Tab
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
            <span class="pager-label">{nextTabInfo.label}</span>
          </button>
        </footer>

      </main>
    </div>
  </div>

  <script>
    state sidebarCollapsed = false;
    state activeTab = 'intro';
    state introCount = 3;
    state copied = false;
    state progressPct = 25;
    state progressOpacity = 1;

    state tabs = [
      {
        id: 'intro',
        label: 'Introduction',
        desc: 'Framework philosophy & live demo',
        badge: 'Overview',
        iconSvg: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>'
      },
      {
        id: 'setup',
        label: 'Setup',
        desc: 'Zero-config starter guide',
        badge: '30s',
        iconSvg: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>'
      },
      {
        id: 'api',
        label: 'API Reference',
        desc: 'Directives & core primitives',
        badge: 'v2.4',
        iconSvg: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></svg>'
      },
      {
        id: 'features',
        label: 'Architecture',
        desc: 'Full-stack engine & security',
        badge: 'Batteries',
        iconSvg: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>'
      }
    ];

    derive prevTabInfo = (() => {
      const idx = tabs.findIndex((t) => t.id === activeTab);
      return idx > 0 ? tabs[idx - 1] : null;
    })();

    derive nextTabInfo = (() => {
      const idx = tabs.findIndex((t) => t.id === activeTab);
      return idx >= 0 && idx < tabs.length - 1 ? tabs[idx + 1] : null;
    })();

    action selectTab(id) {
      if (activeTab === id) return;
      activeTab = id;
      const idx = tabs.findIndex((t) => t.id === id);
      const targetPct = Math.round(((idx + 1) / tabs.length) * 100);
      progressOpacity = 1;
      progressPct = Math.max(15, targetPct - 15);
      setTimeout(() => { progressPct = targetPct; }, 30);
      if (typeof window !== 'undefined') {
        if (window.scrollY > 160) {
          window.scrollTo({ top: 120, behavior: 'smooth' });
        }
        if (window.history && window.history.replaceState) {
          window.history.replaceState(null, '', '#' + id);
        }
      }
    }

    action toggleSidebar() {
      sidebarCollapsed = !sidebarCollapsed;
    }

    action copySnippet(text) {
      if (typeof navigator !== 'undefined' && navigator.clipboard) {
        navigator.clipboard.writeText(text).then(() => {
          copied = true;
          setTimeout(() => { copied = false; }, 2000);
        });
      }
    }

    on ready {
      if (typeof window !== 'undefined') {
        const hash = window.location.hash.replace(/^#/, '');
        if (hash && tabs.some((t) => t.id === hash)) {
          activeTab = hash;
        }

        const handleKey = (e) => {
          if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
          if (e.key === 'ArrowRight' && nextTabInfo) {
            selectTab(nextTabInfo.id);
          } else if (e.key === 'ArrowLeft' && prevTabInfo) {
            selectTab(prevTabInfo.id);
          }
        };
        window.addEventListener('keydown', handleKey);
      }
    }
  </script>

  <style scoped>
    /* TOP PROGRESS BAR */
    .demo-top-progress-track {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: transparent;
      z-index: 1000;
      pointer-events: none;
    }
    .demo-top-progress-bar {
      height: 100%;
      background: linear-gradient(90deg, #ef4444, #f97316);
      box-shadow: 0 0 10px rgba(239, 68, 68, 0.6);
      transition: width 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.35s ease;
    }

    .demo-docs-wrapper {
      font-family: var(--font, system-ui, -apple-system, sans-serif);
      color: var(--foreground);
      width: 100%;
      max-width: 1140px;
      margin: 0 auto;
      padding: 0 16px;
      box-sizing: border-box;
    }

    /* TOPBAR */
    .demo-docs-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 16px 0;
      border-bottom: 1px solid var(--border);
      flex-wrap: wrap;
    }
    .demo-topbar-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .demo-title-group {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .demo-docs-topbar h1 {
      font-size: 20px;
      font-weight: 700;
      margin: 0;
      letter-spacing: -0.02em;
    }
    .demo-badge-pill {
      font-size: 11px;
      font-weight: 600;
      background: var(--accent);
      color: var(--muted);
      border: 1px solid var(--border);
      padding: 2px 8px;
      border-radius: 999px;
    }
    .sidebar-toggle-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--card);
      color: var(--foreground);
      border: 1px solid var(--border);
      padding: 6px 12px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 500;
      transition: all 0.15s ease;
    }
    .sidebar-toggle-btn:hover {
      background: var(--accent);
      border-color: var(--muted);
    }

    /* TOP HORIZONTAL SEGMENTED TABS */
    .demo-top-tabs {
      display: flex;
      align-items: center;
      gap: 6px;
      background: var(--card);
      padding: 4px;
      border-radius: 10px;
      border: 1px solid var(--border);
      overflow-x: auto;
    }
    .demo-tab-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: transparent;
      border: 1px solid transparent;
      color: var(--muted);
      font-size: 13px;
      font-weight: 500;
      padding: 6px 12px;
      border-radius: 7px;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      white-space: nowrap;
    }
    .demo-tab-btn:hover {
      color: var(--foreground);
      background: var(--accent);
    }
    .demo-tab-btn.is-active {
      color: var(--foreground);
      background: var(--background);
      border-color: var(--border);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
      font-weight: 600;
    }
    .demo-tab-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      color: inherit;
    }
    .demo-tab-tag {
      font-size: 10px;
      padding: 1px 6px;
      border-radius: 999px;
      background: var(--accent);
      color: var(--muted);
      border: 1px solid var(--border);
      font-weight: 600;
    }
    .demo-tab-btn.is-active .demo-tab-tag {
      background: rgba(255, 45, 32, 0.12);
      color: #ef4444;
      border-color: rgba(255, 45, 32, 0.2);
    }

    /* LAYOUT */
    .demo-docs-layout {
      display: grid;
      grid-template-columns: 260px minmax(0, 1fr);
      gap: 28px;
      margin-top: 24px;
      padding-bottom: 48px;
    }

    /* SIDEBAR */
    .demo-docs-sidebar {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 18px;
      height: fit-content;
    }
    .demo-sidebar-heading {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      margin-bottom: 12px;
      padding-left: 4px;
    }
    .demo-sidebar-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .demo-sidebar-item {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 10px;
      background: transparent;
      border: 1px solid transparent;
      border-radius: 8px;
      cursor: pointer;
      text-align: left;
      color: var(--muted);
      transition: background 0.15s ease, color 0.15s ease;
      transform: none !important;
    }
    .demo-sidebar-item:hover {
      color: var(--foreground);
      background: var(--accent);
    }
    .demo-sidebar-item.is-active {
      color: var(--foreground);
      background: var(--accent);
      border-color: var(--border);
      font-weight: 600;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
    }
    .demo-item-icon {
      display: flex;
      align-items: center;
      color: inherit;
    }
    .demo-sidebar-item.is-active .demo-item-icon {
      color: #ef4444;
    }
    .demo-item-text {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
    }
    .demo-item-label {
      font-size: 13.5px;
      line-height: 1.3;
    }
    .demo-item-desc {
      font-size: 11px;
      color: var(--muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      opacity: 0.8;
    }
    .demo-item-badge {
      font-size: 10px;
      padding: 1px 6px;
      border-radius: 999px;
      background: var(--border);
      color: var(--muted);
      font-weight: 600;
    }
    .demo-sidebar-item.is-active .demo-item-badge {
      background: rgba(255, 45, 32, 0.12);
      color: #ef4444;
    }
    .demo-keyboard-hint {
      margin-top: 20px;
      padding-top: 14px;
      border-top: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--muted);
    }
    .demo-kbd {
      display: inline-block;
      padding: 2px 6px;
      font-size: 11px;
      font-family: inherit;
      background: var(--accent);
      border: 1px solid var(--border);
      border-radius: 4px;
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.1);
    }

    /* MAIN TAB PANELS & STABLE SMOOTH TRANSITIONS */
    .demo-docs-main {
      min-width: 0;
      min-height: 540px;
    }
    .demo-tab-panel {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 32px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
      min-height: 480px;
      box-sizing: border-box;
      will-change: opacity, transform;
    }
    .tab-fade-slide {
      animation: smoothTabGlide 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes smoothTabGlide {
      0% {
        opacity: 0;
        transform: translateY(4px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .tab-panel-header {
      margin-bottom: 24px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 20px;
    }
    .tab-panel-meta {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
      font-size: 12px;
      color: var(--muted);
