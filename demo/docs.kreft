    .btn-demo-action.secondary {
      background: var(--accent);
      color: var(--foreground);
      border: 1px solid var(--border);
    }
    .counter-double {
      margin: 0;
      font-size: 13px;
      color: var(--muted);
    }

    /* STEPS FLOW (SETUP TAB) */
    .steps-flow {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .step-card {
      display: flex;
      gap: 16px;
      padding: 16px;
