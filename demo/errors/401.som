<!-- errors/401.som: shown after abort(401), for example when the API says the visitor isn't signed in. Change the words as you like. -->
layout 'errors/minimal.som'
prop status = 401
prop title = ''
prop message = ''

<view>
  <som-section name="code">401</som-section>
  <som-section name="title">Unauthorized</som-section>
  <som-section name="message">{message || 'You need to sign in to see this page.'}</som-section>
</view>
