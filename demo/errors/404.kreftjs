<!-- errors/404.kreftjs: shown for an address no route knows, and after abort(404). Change the words as you like. -->
layout 'errors/minimal.kreftjs'
prop status = 404
prop title = ''
prop message = ''

<view>
  <kreft-section name="code">404</kreft-section>
  <kreft-section name="title">Not Found</kreft-section>
  <kreft-section name="message">{message || 'Sorry, the page you are looking for could not be found.'}</kreft-section>
</view>
