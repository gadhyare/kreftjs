<!-- errors/503.som: shown after abort(503), for example during maintenance. Change the words as you like. -->
layout 'errors/minimal.som'
prop status = 503
prop title = ''
prop message = ''

<view>
  <som-section name="code">503</som-section>
  <som-section name="title">Service Unavailable</som-section>
  <som-section name="message">{message || "We're doing some maintenance. Please check back soon."}</som-section>
</view>
