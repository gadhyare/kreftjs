<!-- errors/419.som: shown after abort(419), for example when a CSRF token is expired. Change the words as you like. -->
layout 'errors/minimal.som'
prop status = 419
prop title = ''
prop message = ''

<view>
  <som-section name="code">419</som-section>
  <som-section name="title">Page Expired</som-section>
  <som-section name="message">{message || 'This page expired. Reload it and try again.'}</som-section>
</view>
