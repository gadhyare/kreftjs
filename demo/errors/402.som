<!-- errors/402.som: shown after abort(402). Change the words as you like. -->
layout 'errors/minimal.som'
prop status = 402
prop title = ''
prop message = ''

<view>
  <som-section name="code">402</som-section>
  <som-section name="title">Payment Required</som-section>
  <som-section name="message">{message || 'This needs a payment first.'}</som-section>
</view>
