<!-- Home page: saved state, derived values, actions, and a child component -->

// saved = kept in localStorage, so your name and todos survive a reload
saved userName = ''
saved todos = [
  { id: 1, text: 'Learn Kreft', done: true },
  { id: 2, text: 'Build something', done: false },
]

state newTodo = ''

derive remaining = todos.filter((t) => !t.done).length

action add() {
  if (!newTodo.trim()) return
  todos.push({ id: Date.now(), text: newTodo.trim(), done: false })
  newTodo = ''
}

action remove(id) {
  todos = todos.filter((t) => t.id !== id)
}

<view>
  <section class="card">
    <h1>Hello, {userName || 'stranger'}</h1>
    <input k-model.trim="userName" placeholder="Your name">
  </section>

  <counter start={3}></counter>

  <section class="card">
    <h2>Todos <small class="muted">{remaining} left</small></h2>
    <form @submit.prevent={add}>
      <input k-model="newTodo" placeholder="What needs doing?">
      <button class="primary">Add</button>
    </form>

    <!-- parent → child with a prop, child → parent with an event -->
    <todo-list items={todos} @remove={remove}>
      <template k-slot:empty>Nothing to do. Nice work!</template>
    </todo-list>
  </section>
</view>

<style scoped>
h1 { margin-top: 0; }
form { display: flex; gap: 8px; margin-bottom: 12px; }
form input { flex: 1; }
</style>
