<!-- The template engine: Som.render(view, data) → an HTML string -->
state view = '<h3>Hello {name}</h3>\n<ul>\n  {for skill in skills}\n    <li>{skill}</li>\n  {/for}\n</ul>'
state data = '{\n  "name": "Maxamuud Xussen",\n  "skills": ["JavaScript", "Som.js", "Tailwind"]\n}'
state html = ''
state error = ''

action run() {
  try {
    html = render(view, JSON.parse(data))
    error = ''
  } catch (e) {
    error = e.message
  }
}

watch view { run() }
watch data { run() }
on start { run() }

<view>
  <section class="card">
    <h1>Template engine</h1>
    <p class="lead"><code>Som.render(view, data)</code> turns a view and data into HTML text, for emails, print pages or HTML you build in JavaScript. Edit either box.</p>
    <div class="grid">
      <label>View
        <textarea s-model="view" rows="8" spellcheck="false"></textarea>
      </label>
      <label>Data (JSON)
        <textarea s-model="data" rows="8" spellcheck="false"></textarea>
      </label>
    </div>
    <p class="error" s-if="error">{error}</p>
  </section>

  <section class="card">
    <h2>The HTML text</h2>
    <pre>{html}</pre>
    <h2>How it looks</h2>
    <div class="preview" s-html="html"></div>
    <p class="muted">This page compiles views in the browser, so it doesn't work under a strict Content-Security-Policy.</p>
  </section>
</view>

<style scoped>
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
label { display: flex; flex-direction: column; gap: 6px; font-weight: 600; }
textarea { font: 13px/1.5 ui-monospace, monospace; padding: 8px; border: 1px solid var(--input); }
.preview { border: 1px dashed var(--input); padding: 12px; }
.error { color: var(--destructive); }
</style>
