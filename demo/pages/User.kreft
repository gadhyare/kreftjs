<!-- One user. The route has props: true, so /users/2 gives id = "2" -->
prop id
use users

derive user = users.find(id)

<view>
  <section class="card" k-if="user">
    <kreft-link to="/users">← All users</kreft-link>
    <h2>{user.name}</h2>
    <p>{user.role} · {user.city}</p>
  </section>
  <section class="card" k-else>
    <h2>User not found</h2>
    <kreft-link to="/users">← All users</kreft-link>
  </section>
</view>
