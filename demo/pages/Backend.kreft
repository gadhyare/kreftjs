<!-- Full-stack backend: routes/api.js → TaskController → the Task model → the tasks table (demo/ folders) -->
state priority = ''
state sendKey = true
state message = ''
state tab = 'routes'

load tasks = api.get('/api/tasks', { query: { priority: priority || undefined } })
load summary = api.get('/api/tasks-summary')

// the same rules as the controller's req.validate(); the server's own 422 (like "already taken") lands here too
state draft = form({ title: '', priority: 'normal' }, { title: 'required|min:3|max:120', priority: 'required|in:low,normal,high' })

action add() {
  const task = await draft.$submit((values) => api.post('/api/tasks', values))
  if (!task) return
  draft.$reset({ title: '', priority: draft.priority })
  tasks.reload()
  summary.reload()
}
action toggle(task) {
  Object.assign(task, await api.patch('/api/tasks/' + task.id, { done: !task.done }))
  summary.reload()
}
action remove(task) {
  message = ''
  try {
    await api.delete('/api/tasks/' + task.id, { headers: sendKey ? { 'X-Demo-Key': 'kreft' } : {} })
    tasks.data = tasks.data.filter((t) => t.id !== task.id)
    summary.reload()
  } catch (e) {
    message = e.status + ': ' + e.message // 403 from the DemoKey middleware
  }
}
action completeAll() {
  await api.post('/api/tasks/complete-all')
  tasks.reload()
  summary.reload()
  bus.send('toast', 'All tasks marked done via DB.transaction')
}

state files = {
  routes: `// demo/routes/api.js
const { Route } = require('kreft/server')
const TaskController = require('../app/Http/Controllers/TaskController')

Route.apiResource('tasks', TaskController, { except: ['destroy'] })
  .middleware('throttle:120,1')

Route.middleware('demo-key').group(() => {
  Route.delete('/tasks/{task}', [TaskController, 'destroy'])
})`,
  controller: `// demo/app/Http/Controllers/TaskController.js
class TaskController {
  async index(req) {
    return Task.query()
      .when(req.input('priority'), (q, p) => q.where('priority', p))
      .orderBy('done').orderByDesc('id').get()
  }
  async store(req) {
    const data = await req.validate({
      title: 'required|min:3|max:120|unique:tasks,title',
      priority: 'required|in:low,normal,high',
    })
    return response(await Task.create(data), 201)
  }
  async update(req, id) { … }
  async destroy(req, id) {
    await (await Task.findOrFail(id)).delete()
  }
}`,
  model: `// demo/app/Models/Task.js
const { Model } = require('kreft/server')

class Task extends Model {
  static fillable = ['title', 'priority', 'done']
  static casts = {
    title: 'strip_tags', // automatically strips HTML tags before saving
    done: 'boolean',
  }
}`,
  migration: `// demo/database/migrations/2026_10_29_000001_create_tasks_table.js
module.exports = {
  up(schema) {
    schema.create('tasks', (table) => {
      table.id()
      table.string('title', 120).unique()
      table.enum('priority', ['low', 'normal', 'high']).default('normal')
      table.boolean('done').default(false)
      table.timestamps()
    })
  },
  down(schema) { schema.dropIfExists('tasks') },
}`,
  middleware: `// demo/app/Http/Middleware/DemoKey.js  ('demo-key' in the routes)
class DemoKey {
  async handle(req, next) {
    if (req.header('x-demo-key') !== 'kreft') abort(403, 'Send the header X-Demo-Key: kreft to delete.')
    const response = await next(req)          // the controller runs here
    return response.header('X-Checked-By', 'DemoKey')
  }
}`,
  'cache & redis': `// Atomic Locks, Transactions, Cache & Redis (bin/backend/redis.js)
const { DB, Cache, Redis, config } = require('kreft/server')

// 1) Distributed Atomic Lock + Database Transaction
await Cache.lock('tasks:bulk-complete', 5).block(2, async () => {
  await DB.transaction(async () => {
    await Task.where('done', false).update({ done: true })
  })
})

// 2) Zero-dependency RESP2 Redis client (when CACHE_STORE=redis)
await Redis.hset('metrics:tasks', { lastBulkRun: Date.now() })
const driver = config('database.default', 'sqlite')`,
}

<view>
  <h1>Backend</h1>
  <p class="lead">Full-stack Node.js architecture: a route in <code>routes/api.js</code> calls a controller, the controller uses an Active Record model, and a migration created the table. A middleware guards deleting.</p>

  <section class="card">
    <div class="head">
      <h2>Tasks</h2>
      <p class="muted" k-if="summary.data">
        {summary.data.done} of {summary.data.total} done
        <span k-if="summary.data.heapMB"> · {summary.data.driver} · {summary.data.heapMB} MB heap</span>
      </p>
    </div>
    <form @submit.prevent={add} class="add">
      <input k-model="draft.title" placeholder="A new task" aria-label="Task">
      <select k-model="draft.priority" aria-label="Priority">
        <option value="low">Low</option><option value="normal">Normal</option><option value="high">High</option>
      </select>
      <button class="primary" disabled={draft.$busy}>Add</button>
    </form>
    <p k-if="draft.$error('title')" class="error">{draft.$error('title')}</p>

    <div class="bar">
      <div class="filter" role="group" aria-label="Priority">
        <button class={priority === '' ? 'secondary sm' : 'ghost sm'} @click="priority = ''">All</button>
        <button class={priority === 'high' ? 'secondary sm' : 'ghost sm'} @click="priority = 'high'">High</button>
        <button class={priority === 'normal' ? 'secondary sm' : 'ghost sm'} @click="priority = 'normal'">Normal</button>
        <button class={priority === 'low' ? 'secondary sm' : 'ghost sm'} @click="priority = 'low'">Low</button>
        <button class="ghost sm" @click={completeAll} title="Run atomic DB.transaction + Cache.lock">Complete all</button>
      </div>
      <label class="key"><input type="checkbox" k-model="sendKey"> Send <code>X-Demo-Key</code></label>
    </div>
    <p k-if="message" class="alert danger">{message}</p>

    <p k-if="tasks.loading" class="muted">Loading…</p>
    <p k-elif="tasks.error" class="error">{tasks.error.message}</p>
    <ul k-else class="tasks">
      {for task in tasks.data key task.id}
        <li class={task.done ? 'done' : ''}>
          <label><input type="checkbox" checked={task.done} @change="toggle(task)"> <span>{task.title}</span></label>
          <span class="badge">{task.priority}</span>
          <button class="ghost sm" @click="remove(task)">Delete</button>
        </li>
      {empty}
        <li class="muted">No tasks{priority ? ' with ' + priority + ' priority' : ''}. Run <code>node bin/kreft.js db:seed --backend demo</code> for a few.</li>
      {/for}
    </ul>
  </section>

  <section class="card">
    <h2>The files</h2>
    <div class="tabs" role="tablist">
      {for name in Object.keys(files)}
        <button role="tab" aria-selected={tab === name ? 'true' : 'false'} class={tab === name ? 'on' : ''} @click="tab = name">{name}</button>
      {/for}
    </div>
    <pre>{files[tab]}</pre>
    <p class="muted">Make your own with <code>kreft make:model Post --all</code> (model, migration, controller, seeder), <code>kreft make:middleware</code>, then <code>kreft route:list</code>.</p>
  </section>
</view>

<style scoped>
.head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
.head p { margin: 0; }
.add { display: flex; gap: 8px; margin: 8px 0 4px; flex-wrap: wrap; }
.add input { flex: 1; min-width: 180px; }
.error { margin: 4px 0; }
.bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 16px 0 8px; flex-wrap: wrap; }
.filter { display: flex; gap: 4px; }
.key { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); }
.tasks { list-style: none; margin: 0; padding: 0; border: 1px solid var(--border); }
.tasks li { display: flex; align-items: center; gap: 12px; padding: 6px 8px 6px 14px; border-bottom: 1px solid var(--border); }
.tasks li:last-child { border-bottom: 0; }
.tasks li.muted { padding: 14px; display: block; }
.tasks label { flex: 1; display: flex; align-items: center; gap: 10px; }
.tasks li.done span:not(.badge) { color: var(--muted); text-decoration: line-through; }
.tabs { display: flex; border-bottom: 1px solid var(--border); margin-bottom: 12px; overflow-x: auto; }
.tabs button { border: 0; border-bottom: 2px solid transparent; background: none; color: var(--muted); height: 34px; padding: 0 12px; }
.tabs button.on { color: var(--foreground); border-bottom-color: var(--foreground); }
pre { white-space: pre; }
</style>
