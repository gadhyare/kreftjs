<!-- k-if / k-elif / k-else · k-show · k-html · :class / :style · k-ref · a custom directive · kreft-portal -->
state level = 60
state visible = true
state open = false
state box = null
state richHtml = '<b>Safe bold</b>, <i>italic</i>, and <img src=x onerror=alert(1)> (onerror stripped!)'

action focusBox() { box.focus() }

<view>
  <section class="card">
    <h1>Directives</h1>
    <p class="lead">Small attributes that change how an element behaves.</p>

    <h2><code>k-if</code> · <code>k-elif</code> · <code>k-else</code></h2>
    <input type="range" min="0" max="100" k-model.number="level" aria-label="Level">
    <p k-if="level >= 80" class="good">High: {level}</p>
    <p k-elif="level >= 40">Medium: {level}</p>
    <p k-else class="bad">Low: {level}</p>

    <h2><code>:style</code> and <code>:class</code></h2>
    <div class="track"><div class="bar" :class="{ high: level >= 80 }" :style="{ width: level + '%' }"></div></div>
  </section>

  <section class="card">
    <h2><code>k-show</code> and <code>k-html</code> (Auto-Sanitized)</h2>
    <label class="check"><input type="checkbox" k-model="visible"> Show the box</label>
    <p k-show="visible" class="box">k-show hides me with CSS; k-if would remove me.</p>

    <p class="muted"><code>k-html</code> renders rich HTML through <code>Kreft.cleanHtml()</code> so scripts and event handlers are stripped automatically (<kreft-link to="/security">open full XSS playground</kreft-link>):</p>
    <input k-model="richHtml" aria-label="Rich HTML">
    <div class="box" k-html="richHtml"></div>
  </section>

  <section class="card">
    <h2><code>k-ref</code> and a custom directive</h2>
    <p class="muted"><code>k-focus</code> is registered in <code>index.html</code>; the first box gets the focus when the page opens.</p>
    <input k-focus placeholder="I got the focus">
    <input k-ref="box" placeholder="k-ref gives you this box">
    <button @click={focusBox}>Focus the second box</button>
  </section>

  <section class="card">
    <h2><code>&lt;kreft-portal&gt;</code></h2>
    <p class="muted">The dialog is written here but drawn at the end of the page, above everything.</p>
    <button class="primary" @click="open = true">Open dialog</button>
    <kreft-portal to="body">
      <div class="backdrop" k-if="open" @click.self="open = false">
        <div class="dialog" role="dialog" aria-label="Example dialog">
          <h2>Hello from a portal</h2>
          <p>Press the button or click outside to close.</p>
          <button class="primary" @click="open = false">Close</button>
        </div>
      </div>
    </kreft-portal>
  </section>
</view>

<style scoped>
input[type=range] { width: 100%; }
.good { color: var(--success); font-weight: 600; }
.bad { color: var(--destructive); font-weight: 600; }
.track { height: 12px; background: var(--border); overflow: hidden; }
.bar { height: 100%; background: var(--muted); transition: width 0.2s; }
.bar.high { background: var(--ember); }
.box { background: var(--accent); padding: 10px;}
.check { display: flex; gap: 8px; align-items: center; }
input:not([type]) { display: block; width: 100%; margin-bottom: 8px; box-sizing: border-box; }
.backdrop { position: fixed; inset: 0; background: rgba(20, 18, 31, 0.5); display: flex; align-items: center; justify-content: center; z-index: 30; padding: 16px; }
.dialog { background: #fff; padding: 20px; max-width: 360px; width: 100%; }
</style>
