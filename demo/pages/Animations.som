<!-- s-animate: fade, slide, scale, pop or your own CSS · lists that move · s-animate.after -->
state shown = true
state boxShown = true
state liked = false
state fruit = ''
state next = 5
state fruits = [
  { id: 1, name: 'Banana' },
  { id: 2, name: 'Mango' },
  { id: 3, name: 'Papaya' },
  { id: 4, name: 'Guava' },
]
state dropCss = `.drop-in, .drop-out { transition: all .35s ease }
.drop-in-from { opacity: 0; transform: translateY(-30px) }
.drop-out-to { opacity: 0; transform: translateX(60px) rotate(6deg) }`

action add() {
  fruits.unshift({ id: next, name: fruit.trim() || 'Fruit ' + next })
  next++
  fruit = ''
}
action remove(id) { fruits = fruits.filter((f) => f.id !== id) }
action shuffle() { fruits = [...fruits].sort(() => Math.random() - 0.5) }

<view>
  <section class="card">
    <h1>Animations</h1>
    <p class="lead"><code>s-animate</code> plays CSS classes while an element comes in and goes out. Four are ready to use: fade, slide, scale and pop.</p>
    <button class="primary" @click="shown = !shown">{shown ? 'Hide' : 'Show'} them</button>
    <div class="grid">
      <div class="spot"><p s-if="shown" s-animate="fade" class="chip">fade</p></div>
      <div class="spot"><p s-if="shown" s-animate="slide" class="chip">slide</p></div>
      <div class="spot"><p s-if="shown" s-animate="scale" class="chip">scale</p></div>
      <div class="spot"><p s-if="shown" s-animate="pop" class="chip">pop</p></div>
    </div>
  </section>

  <section class="card">
    <h2>Your own animation, with <code>s-show</code></h2>
    <p class="muted">Name it, then write CSS for <code>name-in</code> / <code>name-in-from</code> (coming in) and <code>name-out</code> / <code>name-out-to</code> (going out).</p>
    <button @click="boxShown = !boxShown">Toggle</button>
    <div s-show="boxShown" s-animate="drop" class="box">I drop in and fly out.</div>
    <pre>{dropCss}</pre>
  </section>

  <section class="card">
    <h2>Lists: <code>\{for … animate slide}</code></h2>
    <p class="muted">New items slide in, removed ones slide out, and the rest move to their new place.</p>
    <form class="row" @submit.prevent={add}>
      <input s-model="fruit" placeholder="A fruit" aria-label="Fruit">
      <button class="primary">Add</button>
      <button type="button" @click={shuffle}>Shuffle</button>
    </form>
    <ul class="fruits">
      {for f in fruits key f.id animate slide}
        <li>{f.name} <button @click="remove(f.id)" aria-label={'Remove ' + f.name}>✕</button></li>
      {empty}
        <li class="muted">No fruit left.</li>
      {/for}
    </ul>
  </section>

  <section class="card">
    <h2>One after the other: <code>s-animate.after</code></h2>
    <p class="muted">With <code>s-if</code> / <code>s-else</code>, <code>.after</code> lets the old one leave before the new one comes in. The pages of this demo change the same way: <code>&lt;som-view s-animate.after="page"&gt;</code>.</p>
    <button @click="liked = !liked">Switch</button>
    <p s-if="liked" s-animate.after="scale" class="chip big">❤ Liked</p>
    <p s-else class="chip big">♡ Not yet</p>
  </section>
</view>

<style scoped>
.grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 14px; }
.spot { height: 52px; border: 1px dashed var(--input); display: grid; place-items: center; }
.chip { margin: 0; padding: 6px 14px; background: var(--ink); color: #fff; font-weight: 600; }
.chip.big { display: inline-block; margin-top: 12px; font-size: 18px; }
.box { margin-top: 12px; padding: 16px; background: var(--accent); border: 1px solid var(--border); }
.drop-in, .drop-out { transition: all .35s ease; }
.drop-in-from { opacity: 0; transform: translateY(-30px); }
.drop-out-to { opacity: 0; transform: translateX(60px) rotate(6deg); }
.row { display: flex; gap: 8px; flex-wrap: wrap; }
.fruits { list-style: none; padding: 0; margin: 12px 0 0; }
.fruits li { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; margin-bottom: 6px; background: var(--accent);}
@media (max-width: 560px) { .grid { grid-template-columns: repeat(2, 1fr); } }
</style>
