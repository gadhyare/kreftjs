<!-- nested routes: this page is the frame, its <som-view> shows the child route -->
state tabs = [
  { to: '/settings', label: 'General' },
  { to: '/settings/account', label: 'Account' },
  { to: '/settings/look', label: 'Look' },
]

<view>
  <section class="card">
    <h1>Settings</h1>
    <p class="lead">A route with <code>children</code>. This frame stays; the part below changes with the address.</p>
    <nav class="sub">
      {for t in tabs key t.to}<som-link to={t.to} exact-class="here">{t.label}</som-link>{/for}
    </nav>
    <div class="child">
      <som-view s-animate.after="fade"></som-view>
    </div>
  </section>
</view>

<style scoped>
.sub { display: flex; gap: 4px; border-bottom: 1px solid var(--border); margin-bottom: 14px; }
.sub a { padding: 8px 12px; text-decoration: none; color: var(--muted); border-bottom: 2px solid transparent; margin-bottom: -1px; }
.sub a.here { color: var(--ink); border-bottom-color: var(--ember); font-weight: 600; }
.child { min-height: 110px; }
</style>
