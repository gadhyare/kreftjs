<!-- The router: the current route, query strings, navigating from code, guards and redirects -->
action goUser() { $router.go('/users/2') }
action goBack() { $router.back() }

<view>
  <section class="card">
    <h1>Router</h1>
    <p class="lead">Every page in this menu is a route. Links change the page without reloading it, and the address stays clean.</p>

    <div class="notice" k-if="$route.query.blocked">The guard on <code>/secret</code> sent you here instead.</div>
    <div class="notice" k-if="$route.query.from">You opened <code>/{$route.query.from}</code>, which redirects here.</div>

    <h2>The current route</h2>
    <table>
      <tbody>
        <tr><th>$route.path</th><td><code>{$route.path}</code></td></tr>
        <tr><th>$route.fullPath</th><td><code>{$route.fullPath}</code></td></tr>
        <tr><th>$route.query</th><td><code>{JSON.stringify($route.query)}</code></td></tr>
      </tbody>
    </table>
  </section>

  <section class="card">
    <h2>Query strings</h2>
    <div class="row">
      <kreft-link to="/router?tab=one">?tab=one</kreft-link>
      <kreft-link to="/router?tab=two">?tab=two</kreft-link>
      <kreft-link to="/router">no query</kreft-link>
    </div>
    <p k-if="$route.query.tab === 'one'">You are on tab one.</p>
    <p k-elif="$route.query.tab === 'two'">You are on tab two.</p>
    <p k-else class="muted">Pick a tab.</p>
  </section>

  <section class="card">
    <h2>Navigating from code, params, guards</h2>
    <div class="row">
      <button @click={goUser}>$router.go('/users/2')</button>
      <button @click={goBack}>$router.back()</button>
      <kreft-link to="/users/1">A route with a param: /users/1</kreft-link>
      <kreft-link to="/secret">A guarded route: /secret</kreft-link>
      <kreft-link to="/old-page">A redirect: /old-page</kreft-link>
      <kreft-link to="/no-such-page">A 404</kreft-link>
    </div>
  </section>

  <section class="card">
    <h2>Dedicated HTTP error pages</h2>
    <p class="muted">The files in <code>demo/errors/</code>. An address no route knows shows <code>errors/404.kreft</code>; <code>abort()</code> shows another one, and the address stays.</p>
    <div class="row">
      <button @click="abort(403, 'Only the owner can see this page.')">abort(403, '…')</button>
      <button @click="abort(419)">abort(419)</button>
      <button @click="abort(429)">abort(429)</button>
      <button @click="abort(500)">abort(500)</button>
      <button @click="abort(503)">abort(503)</button>
      <button @click="abort(409, 'Someone changed this note first.')">abort(409, '…')</button>
    </div>
  </section>
</view>

<style scoped>
.row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
.notice { background: var(--accent); border: 1px solid var(--border); padding: 10px; margin-bottom: 12px; }
table { border-collapse: collapse; }
th { text-align: left; padding: 4px 16px 4px 0; font-weight: 600; white-space: nowrap; }
td { padding: 4px 0; }
</style>
