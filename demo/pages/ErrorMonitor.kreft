<!--
  ErrorMonitor Page — Interactive Kreft Diagnostic Inspector Showcase
  Uses Kreft's own minimalist geometric UI and authentic JavaScript/.kreft stack traces.
-->
import ErrorMonitor from '../errors/ErrorMonitor.kreft'

state scenario = 'method'

derive sampleError = scenario === 'method' ? {
  name: 'TypeError',
  message: 'Post.qquery is not a function',
  frames: [
    { fn: 'PostController.index', file: 'backend/app/Http/Controllers/PostController.js', line: 13, col: 25, isApp: true, snippet: [
      { num: 10, code: 'class PostController {' },
      { num: 11, code: '  async index(req) {' },
      { num: 12, code: '    // Typo in static query builder call' },
      { num: 13, code: '    const posts = await Post.qquery().orderByDesc("id").get()', isTarget: true },
      { num: 14, code: '    return { posts }' },
      { num: 15, code: '  }' },
      { num: 16, code: '}' }
    ]},
    { fn: 'Router.dispatch', file: 'bin/backend/http.js', line: 182, col: 12, isApp: false },
    { fn: 'Server.handleRequest', file: 'bin/kreft.js', line: 412, col: 9, isApp: false }
  ],
  solution: {
    title: 'Unknown Model Method',
    message: 'Did you mean Post.query() instead of Post.qquery()?'
  }
} : scenario === 'null' ? {
  name: 'TypeError',
  message: "Cannot read properties of undefined (reading 'email')",
  frames: [
    { fn: 'ProfileController.update', file: 'backend/app/Http/Controllers/ProfileController.js', line: 31, col: 32, isApp: true, snippet: [
      { num: 28, code: '  async update(req) {' },
      { num: 29, code: '    const user = req.user' },
      { num: 30, code: '    // Accessing nested property without optional chaining' },
      { num: 31, code: '    const email = user.account.email', isTarget: true },
      { num: 32, code: '    return { ok: true, email }' },
      { num: 33, code: '  }' }
    ]},
    { fn: 'Router.dispatch', file: 'bin/backend/http.js', line: 210, col: 14, isApp: false }
  ],
  solution: {
    title: 'Null Reference Guard',
    message: 'user.account is undefined. Use optional chaining (user.account?.email) or verify req.user before reading.'
  }
} : {
  name: 'DatabaseError',
  message: 'SQLITE_ERROR: no such table: tasks_archive',
  frames: [
    { fn: 'TaskController.archive', file: 'backend/app/Http/Controllers/TaskController.js', line: 44, col: 18, isApp: true, snippet: [
      { num: 41, code: '  async archive(req) {' },
      { num: 42, code: '    // Querying a table whose migration has not run yet' },
      { num: 43, code: "    const rows = await DB.table('tasks_archive').get()", isTarget: true },
      { num: 44, code: '    return { rows }' },
      { num: 45, code: '  }' }
    ]},
    { fn: 'Database.query', file: 'bin/backend/db.js', line: 120, col: 9, isApp: false }
  ],
  solution: {
    title: 'Pending Database Migration',
    message: "Run 'kreft db:migrate' or create the table with 'kreft make:migration create_tasks_archive_table'."
  }
}

<view>
  <h1>Error Monitor</h1>
  <p class="lead">Kreft catches unhandled server and component exceptions with its own geometric inspector: interactive stack frames, terminal code preview, and fix suggestions.</p>

  <div class="switcher" role="group" aria-label="Exception Scenarios">
    <span class="label-inline">Simulate Exception:</span>
    <button class={scenario === 'method' ? 'primary sm' : 'secondary sm'} @click="scenario = 'method'">
      1. Method Typo (Post.qquery)
    </button>
    <button class={scenario === 'null' ? 'primary sm' : 'secondary sm'} @click="scenario = 'null'">
      2. Null Reference (TypeError)
    </button>
    <button class={scenario === 'sql' ? 'primary sm' : 'secondary sm'} @click="scenario = 'sql'">
      3. Missing Table (DatabaseError)
    </button>
  </div>

  <error-monitor
    error={sampleError}
    status={500}
    title={sampleError.name}
    message={sampleError.message}
    frames={sampleError.frames}
    solution={sampleError.solution}>
  </error-monitor>
</view>

<style scoped>
.switcher { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 12px 16px; border: 1px solid var(--border); background: var(--accent); margin-bottom: 16px; }
.label-inline { font-family: var(--mono); font-size: 12px; font-weight: 600; color: var(--muted); margin-inline-end: 4px; }
</style>
