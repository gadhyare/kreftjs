<!-- Sharing data: stores (use), share / receive, and the event bus -->
import ThemeBox from '../components/ThemeBox.som'

use cart
state settings = { theme: 'light' }
share settings = settings
state messages = []

// listeners added here are removed when you leave the page
on start {
  bus.on('ping', (text) => messages.unshift(new Date().toLocaleTimeString() + ' · ' + text))
}

action addSticker() { cart.add({ name: 'Som.js sticker', price: 2 }) }
action ping() { bus.send('ping', 'Hello from the page') }

<view>
  <section class="card">
    <h1>Sharing data</h1>
    <p class="lead">Three ways for components to share data.</p>

    <h2>1. A store: <code>use cart</code></h2>
    <p>The cart has <strong>{cart.count}</strong> {cart.count === 1 ? 'item' : 'items'} (total ${cart.total}). The badge in the header reads the same store.</p>
    <button class="primary" @click={addSticker}>Add a sticker</button>
  </section>

  <section class="card">
    <h2>2. <code>share</code> / <code>receive</code></h2>
    <p>This page shares <code>settings</code>. The theme is <strong>{settings.theme}</strong>.</p>
    <theme-box></theme-box>
  </section>

  <section class="card">
    <h2>3. The bus: <code>bus.send</code> / <code>bus.on</code></h2>
    <button @click={ping}>Send a message</button>
    <ul>
      {for message in messages}
        <li>{message}</li>
      {empty}
        <li class="muted">No messages yet. Press a button above or in the child.</li>
      {/for}
    </ul>
  </section>
</view>
