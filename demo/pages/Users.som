<!-- Users list with search, reading the shared "users" store -->
use users

state search = ''
derive filtered = users.list.filter((u) => u.name.toLowerCase().includes(search.toLowerCase()))

<view>
  <section class="card">
    <h2>Users</h2>
    <input s-model="search" placeholder="Search by name…">
    <ul>
      <li s-each="user in filtered" s-key="user.id">
        <som-link to="/users/{user.id}">{user.name}</som-link>
        <span class="muted">{user.city}</span>
      </li>
      <li s-if="!filtered.length" class="muted">No one matches "{search}".</li>
    </ul>
  </section>
</view>

<style scoped>
input { width: 100%; margin-bottom: 8px; }
ul { list-style: none; padding: 0; margin: 0; }
li { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--border); }
</style>
