<!-- HTML Security, XSS Sanitization, k-html & Session Inactivity Watchdog -->
state rawHtml = '<h3>Welcome to <b>Kreft v2.4</b>!</h3>\n<p>Safe links work: <a href="https://example.com">Docs</a>.</p>\n<img src="x" onerror="alert(\'XSS\')">\n<script>stealCookies()</script>\n<svg onload="alert(1)"></svg>\n<a href="javascript:alert(1)">Malicious Link</a>'

derive cleaned = Kreft.cleanHtml(rawHtml)
derive stripped = Kreft.stripTags(rawHtml)
derive escaped = Kreft.escapeHtml(rawHtml)

state idleActive = false
state idleWarning = false
state idleRemaining = 10
state idleExpired = false
state timerInstance = null
let countdownInterval = null

action startIdleDemo() {
  stopIdleDemo()
  idleActive = true
  idleWarning = false
  idleExpired = false
  idleRemaining = 10

  countdownInterval = setInterval(() => {
    if (idleRemaining > 0) idleRemaining--
  }, 1000)

  timerInstance = Kreft.useInactivityTimer({
    timeout: 10000,
    warningTime: 5000,
    events: ['click', 'keydown'],
    onWarning: () => {
      idleWarning = true
    },
    onTimeout: () => {
      idleExpired = true
      idleActive = false
      idleWarning = false
      clearInterval(countdownInterval)
    },
  })
}

action resetIdleDemo() {
  if (timerInstance) timerInstance.reset()
  idleWarning = false
  idleExpired = false
  idleRemaining = 10
}

action stopIdleDemo() {
  if (timerInstance) {
    timerInstance.stop()
    timerInstance = null
  }
  clearInterval(countdownInterval)
  idleActive = false
  idleWarning = false
}

on destroy {
  stopIdleDemo()
}

action loadPreset(type) {
  if (type === 'xss') {
    rawHtml = '<div onclick="evil()">Click me</div>\n<script>alert("xss")</script>\n<a href="jav&#x09;ascript:alert(1)">Obfuscated JS URL</a>\n<p>Normal <strong>bold</strong> text stays intact.</p>'
  } else if (type === 'svg') {
    rawHtml = '<svg><onload="alert(1)"><circle r="10"/></svg>\n<math><mtext>math vector</mtext></math>\n<blockquote>Quoted safe text with <code>inline code</code>.</blockquote>'
  } else {
    rawHtml = '<h3>Release Notes</h3>\n<ul>\n  <li>Zero-dependency <b>HTML sanitizer</b></li>\n  <li>Automatic <code>k-html</code> protection</li>\n</ul>'
  }
}

<view>
  <h1>HTML Security &amp; Session Watchdog</h1>
  <p class="lead">Kreft protects both client and server against Cross-Site Scripting (XSS) and unattended sessions out of the box—with zero external dependencies.</p>

  <section class="card">
    <div class="head">
      <h2>1. Live XSS Sanitizer Playground</h2>
      <div class="presets">
        <button class="sm ghost" @click="loadPreset('xss')">XSS &amp; Entity Payload</button>
        <button class="sm ghost" @click="loadPreset('svg')">SVG / Math Payload</button>
        <button class="sm ghost" @click="loadPreset('clean')">Clean Rich Text</button>
      </div>
    </div>
    <p class="muted">Type or paste untrusted HTML below. Dangerous tags (<code>&lt;script&gt;</code>, <code>&lt;svg&gt;</code>, <code>&lt;iframe&gt;</code>), inline event handlers (<code>onerror</code>, <code>onclick</code>), and entity-obfuscated <code>javascript:</code> / <code>data:</code> URLs are neutralized automatically.</p>

    <label class="label">Untrusted HTML Input</label>
    <textarea k-model="rawHtml" rows="6" class="code-input" aria-label="Untrusted HTML Input"></textarea>

    <div class="grid">
      <div class="panel">
        <h3><code>k-html</code> Live Render (Safe DOM)</h3>
        <div class="preview" k-html="rawHtml"></div>
      </div>
      <div class="panel">
        <h3><code>Kreft.cleanHtml(input)</code> Output</h3>
        <pre class="out">{cleaned}</pre>
      </div>
      <div class="panel">
        <h3><code>Kreft.stripTags(input)</code> (Plain Text)</h3>
        <pre class="out">{stripped}</pre>
      </div>
      <div class="panel">
        <h3><code>Kreft.escapeHtml(input)</code> (Entities)</h3>
        <pre class="out">{escaped}</pre>
      </div>
    </div>
  </section>

  <section class="card">
    <h2>2. Session Inactivity Watchdog (<code>Kreft.useInactivityTimer</code>)</h2>
    <p class="muted">Protects authenticated dashboards when a user leaves their screen unattended. Try the 10-second interactive simulation below (warning triggers at 5 seconds left):</p>

    <div class="row">
      <button class="primary" @click={startIdleDemo} k-if="!idleActive">Start 10s Idle Timer</button>
      <button class="secondary" @click={resetIdleDemo} k-if="idleActive">Simulate Activity (Reset)</button>
      <button class="ghost" @click={stopIdleDemo} k-if="idleActive">Stop Timer</button>
      <span class="badge" k-if="idleActive">Expires in ~{idleRemaining}s</span>
    </div>

    <div class="alert warn" k-if="idleWarning">
      <strong>Inactivity Warning:</strong> Your session will expire in {idleRemaining}s due to inactivity.
      <button class="sm primary" @click={resetIdleDemo}>Stay Signed In</button>
    </div>

    <div class="alert danger" k-if="idleExpired">
      <strong>Session Expired:</strong> <code>onTimeout</code> fired! In a real app, this redirects to <code>/login?reason=inactive</code>.
    </div>
  </section>

  <section class="card">
    <h2>3. Server-Side Request &amp; Model Sanitization</h2>
    <pre>// 1) Request sanitization in Controllers
const safeBody  = req.clean('content')      // strips scripts &amp; unsafe attributes
const plainText = req.strip('title')        // strips all HTML tags
const safeObj   = req.html('bio')           // wraps in SafeHtml instance

// 2) Automatic Model Casts (backend/app/Models/Article.js)
class Article extends Model \{
  static casts = \{
    title:   'strip_tags',   // automatically strips tags before INSERT / UPDATE
    content: 'safe_html',    // sanitizes on write &amp; hydrates as SafeHtml
    snippet: 'escape_html',  // escapes &, &lt;, &gt;, ", '
  }
}</pre>
  </section>
</view>

<style scoped>
.head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
.presets { display: flex; gap: 6px; flex-wrap: wrap; }
.code-input { width: 100%; font-family: var(--mono); font-size: 13px; margin-bottom: 16px; }
.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.panel { border: 1px solid var(--border); padding: 12px; background: var(--background); }
.panel h3 { margin: 0 0 8px; font-size: 13px; color: var(--muted); }
.preview { padding: 10px; border: 1px dashed var(--border); min-height: 72px; }
.out { margin: 0; font-size: 12px; white-space: pre-wrap; word-break: break-word; }
.row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin: 12px 0; }
.alert { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: 12px; }
@media (max-width: 680px) {
  .grid { grid-template-columns: minmax(0, 1fr); }
}
</style>

