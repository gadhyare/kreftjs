<!-- props · events · k-model on a component · slots · scoped slots · dynamic components -->
import Rating from '../components/Rating.kreftjs'
import Panel from '../components/Panel.kreftjs'
import Score from '../components/Score.kreftjs'

saved stars = 3
state shown = 'Rating'
state items = [
  { id: 1, text: 'Read the docs', done: false },
  { id: 2, text: 'Write a component', done: false },
]

action remove(id) { items = items.filter((t) => t.id !== id) }

<view>
  <section class="card">
    <h1>Components</h1>
    <p class="lead">Each <code>.kreftjs</code> file is a component. Use it as a tag, written in kebab-case.</p>

    <h2>Props: parent → child</h2>
    <p class="muted"><code>&lt;counter start=\{3}&gt;</code>: the counter starts from the value the parent gives it.</p>
    <counter start={3}></counter>
  </section>

  <section class="card">
    <h2>Events: child → parent</h2>
    <p class="muted">The list sends <code>remove</code> with an id; this page removes the item.</p>
    <todo-list items={items} @remove={remove}>
      <template k-slot:empty>All removed.</template>
    </todo-list>
  </section>

  <section class="card">
    <h2><code>k-model</code> on a component</h2>
    <rating k-model="stars"></rating>
    <p>You picked <strong>{stars}</strong> of 5 (saved).</p>
  </section>

  <section class="card">
    <h2>Slots and scoped slots</h2>
    <panel title="A panel">
      <p>This paragraph goes into the default slot.</p>
      <template k-slot:footer="{ time }">The panel opened at {time} and sent that time here.</template>
    </panel>
  </section>

  <section class="card">
    <h2>Switching components: <code>&lt;kreft-component :is&gt;</code></h2>
    <div class="row">
      <label class="check"><input type="radio" value="Rating" k-model="shown"> Rating</label>
      <label class="check"><input type="radio" value="Score" k-model="shown"> Score</label>
    </div>
    <kreft-component :is="shown" k-model="stars"></kreft-component>
  </section>
</view>

<style scoped>
.row { display: flex; gap: 16px; margin-bottom: 8px; }
.check { display: flex; gap: 6px; align-items: center; }
</style>
