<!-- /tests: a place to try things, away from your real pages in pages/.
     Put test pages in tests/pages/ and test components in tests/components/. Delete the folder when you don't need it. -->
state name = ''
load hello = api.get('/api/hello', { query: { name: name || undefined } })

<view>
  <section class="page">
    <h1>Test pages</h1>
    <p class="lead">Try things here without touching your app. These files live in <code>tests/</code>.</p>

    <div class="card">
      <h2>A component</h2>
      <p class="muted"><code>tests/components/Counter.kreftjs</code></p>
      <counter start={1}></counter>
    </div>

    <div class="card">
      <h2>Your API</h2>
      <p class="muted"><code>GET /api/hello</code> from <code>routes/api.js</code></p>
      <input k-model="name" placeholder="Your name" aria-label="Name">
      <pre>{hello.loading ? 'Loading…' : hello.error ? hello.error.message : JSON.stringify(hello.data, null, 2)}</pre>
    </div>

    <p><kreft-link to="/tests/about">Another test page</kreft-link></p>
  </section>
</view>

<style scoped>
.page { padding: 40px 0; max-width: 640px; }
input { width: 100%; max-width: 320px; margin-bottom: 12px; }
</style>
