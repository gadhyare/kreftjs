<!-- A test component: a button that counts. Used by tests/pages/Test.som as <counter>. -->
prop start = 0

state count = start
derive double = count * 2

action add() { count++ }

<view>
  <button class="primary" @click={add}>Clicked {count} {count === 1 ? 'time' : 'times'}, double {double}</button>
</view>

<style scoped>
button { font-variant-numeric: tabular-nums; justify-self: start; }
</style>
