<!--
  ErrorMonitor.kreft — Native Kreft Error Inspector & Diagnostic Component
  Built with Kreft's own geometric design system (ui.css tokens, dark/light theme aware, 1px borders, terminal code view).
-->
prop error = null
prop status = 500
prop title = ''
prop message = ''
prop frames = []
prop solution = null
prop request = null

state tab = 'stack'
state selected = 0
state showInternal = false
state copied = false

derive currentTitle = title || (error && error.name) || 'RuntimeError'
derive currentMessage = message || (error && error.message) || 'An unexpected error occurred.'
derive frameList = (frames && frames.length) ? frames : (error && error.frames ? error.frames : [
  { fn: 'PostController.index', file: 'backend/app/Http/Controllers/PostController.js', line: 14, col: 18, isApp: true, snippet: [
    { num: 10, code: 'class PostController {' },
    { num: 11, code: '  async index(req) {' },
    { num: 12, code: '    // Fetch published posts' },
    { num: 13, code: '    const posts = await Post.qquery().orderByDesc("id").get()' },
    { num: 14, code: '    return { posts }', isTarget: true },
    { num: 15, code: '  }' },
    { num: 16, code: '}' }
  ]},
  { fn: 'Router.dispatch', file: 'bin/backend/http.js', line: 182, col: 12, isApp: false },
  { fn: 'Server.handleRequest', file: 'bin/kreftjs.js', line: 412, col: 9, isApp: false },
])

derive internalCount = frameList.filter((f) => !f.isApp).length
derive activeFrame = frameList[selected] || frameList[0] || {}
derive activeSnippet = activeFrame.snippet || [
  { num: Math.max(1, (activeFrame.line || 1) - 1), code: '// Internal runtime frame' },
  { num: activeFrame.line || 1, code: activeFrame.code || (activeFrame.fn || '<anonymous>') + '()', isTarget: true },
]

derive smartSolution = solution || (currentMessage.includes('qquery') ? {
  title: 'Unknown Model Method',
  message: 'Post.qquery is not a function. Did you mean Post.query()?'
} : currentMessage.includes('undefined') ? {
  title: 'Null / Undefined Reference',
  message: 'Guard the target object or use optional chaining (?.) before reading nested properties.'
} : {
  title: 'Diagnostic Hint',
  message: 'Check the highlighted line in the source inspector and verify the inputs passed to this action.'
})

watch error {
  selected = 0
}

action selectFrame(index) {
  selected = index
}

action toggleInternal() {
  showInternal = !showInternal
}

action copyReport() {
  const report = [
    '# Kreft Diagnostic Report',
    '- **Exception:** `' + currentTitle + '` (HTTP ' + status + ')',
    '- **Message:** ' + currentMessage,
    '- **Location:** `' + (activeFrame.file || 'unknown') + ':' + (activeFrame.line || 1) + '`',
    '',
    '## Stack Trace',
    '```text',
    frameList.map((f) => '  at ' + (f.fn || '<anonymous>') + ' (' + f.file + ':' + f.line + ')').join('\n'),
    '```'
  ].join('\n')

  if (typeof navigator !== 'undefined' && navigator.clipboard) {
    navigator.clipboard.writeText(report).then(() => {
      copied = true
      setTimeout(() => { copied = false }, 2000)
    })
  }
}

state docs = (Kreftjs.env.PUBLIC_DOCS_URL || 'http://kreftjs.com').replace(/\/+$/, '')   // where "Documentation" links go: PUBLIC_DOCS_URL in .env

<view>
  <div class="kreft-inspector">
    <!-- Header Card -->
    <section class="card head-card">
      <div class="top-bar">
        <div class="badges">
          <span class="badge danger-badge">HTTP {status}</span>
          <span class="badge solid">{currentTitle}</span>
          <span class="badge">Kreft {Kreftjs.version || '0.0.12-beta'}</span>
        </div>
        <div class="actions">
          <button class="sm" @click={copyReport}>{copied ? 'Copied Markdown' : 'Copy Report'}</button>
          <a href={docs + '/docs'} class="btn sm ghost" target="_blank" rel="noopener">Docs</a>
        </div>
      </div>

      <h2 class="err-msg">{currentMessage}</h2>
      <p class="err-loc" k-if="activeFrame.file">
        in <code>{activeFrame.file}:{activeFrame.line || 1}</code> · <span>{activeFrame.fn || '<anonymous>'}</span>
      </p>

      <!-- Kreft Solution Callout -->
      <div class="hint-box" k-if="smartSolution">
        <div class="hint-head">
          <span class="badge success">Fix Suggestion</span>
          <strong>{smartSolution.title}</strong>
        </div>
        <p class="hint-body">{smartSolution.message}</p>
      </div>
    </section>

    <!-- Kreft Underline Tabs -->
    <div class="tabs" role="tablist" aria-label="Diagnostic Views">
      <button role="tab" aria-selected={tab === 'stack' ? 'true' : 'false'} class={tab === 'stack' ? 'on' : ''} @click="tab = 'stack'">
        Stack Trace ({frameList.length})
      </button>
      <button role="tab" aria-selected={tab === 'context' ? 'true' : 'false'} class={tab === 'context' ? 'on' : ''} @click="tab = 'context'">
        Request &amp; Runtime
      </button>
      <button role="tab" aria-selected={tab === 'share' ? 'true' : 'false'} class={tab === 'share' ? 'on' : ''} @click="tab = 'share'">
        Markdown Report
      </button>
    </div>

    <!-- Tab 1: Stack Trace & Terminal Code Preview -->
    <section class="workbench" k-if="tab === 'stack'">
      <aside class="frame-pane">
        <div class="pane-bar">
          <span>Frames</span>
          <button class="sm ghost toggle-btn" k-if="internalCount > 0" @click={toggleInternal}>
            {showInternal ? 'Hide internal (' + internalCount + ')' : 'Show internal (' + internalCount + ')'}
          </button>
        </div>

        <div class="frame-list">
          {for (frame, idx) in frameList}
            <button
              type="button"
              k-if="frame.isApp || showInternal"
              class={'frame-item' + (selected === idx ? ' active' : '') + (frame.isApp ? '' : ' internal')}
              @click="selectFrame(idx)">
              <div class="frame-top">
                <span class="fn">{frame.fn || '<anonymous>'}</span>
                <span class="tag">{frame.isApp ? 'app' : 'core'}</span>
              </div>
              <div class="file">{frame.file}:{frame.line || 1}</div>
            </button>
          {/for}
        </div>
      </aside>

      <div class="source-pane">
        <div class="pane-bar">
          <code>{activeFrame.file || 'source.js'}:{activeFrame.line || 1}</code>
          <span class="muted">Line {activeFrame.line || 1}</span>
        </div>

        <div class="terminal-code">
          {for line in activeSnippet}
            <div class={'code-line' + (line.isTarget ? ' target' : '')}>
              <span class="ln">{line.num}</span>
              <span class="src">{line.code}</span>
            </div>
          {/for}
        </div>
      </div>
    </section>

    <!-- Tab 2: Request & Runtime Context -->
    <section class="context-grid" k-if="tab === 'context'">
      <div class="card">
        <h3>HTTP Request</h3>
        <table>
          <tbody>
            <tr><th>Method</th><td><code>{request && request.method ? request.method : 'GET'}</code></td></tr>
            <tr><th>Path</th><td><code>{request && request.url ? request.url : $route.fullPath}</code></td></tr>
            <tr><th>Host</th><td><code>{typeof window !== 'undefined' ? window.location.host : 'localhost:8000'}</code></td></tr>
          </tbody>
        </table>
      </div>

      <div class="card">
        <h3>Kreft Runtime</h3>
        <table>
          <tbody>
            <tr><th>Engine</th><td><code>Kreft v{Kreftjs.version || '0.0.12-beta'}</code></td></tr>
            <tr><th>Sanitizer</th><td><code>Active (cleanHtml / SafeHtml)</code></td></tr>
            <tr><th>Environment</th><td><code>development (APP_DEBUG=true)</code></td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Tab 3: Markdown Report -->
    <section class="card" k-if="tab === 'share'">
      <div class="top-bar">
        <h3>Diagnostic Markdown</h3>
        <button class="primary sm" @click={copyReport}>{copied ? 'Copied' : 'Copy to Clipboard'}</button>
      </div>
      <p class="muted">Paste directly into a GitHub Issue or pull request:</p>
      <pre># Kreft Diagnostic Report
- **Exception:** `{currentTitle}` (HTTP {status})
- **Message:** {currentMessage}
- **Location:** `{activeFrame.file}:{activeFrame.line || 1}`</pre>
    </section>
  </div>
</view>

<style scoped>
.kreft-inspector { display: grid; gap: 16px; }
.head-card { margin-bottom: 0; border-inline-start: 3px solid var(--destructive); }
.top-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
.badges, .actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.danger-badge { background: var(--destructive); border-color: var(--destructive); color: #ffffff; }
.err-msg { font-family: var(--mono); font-size: 20px; line-height: 1.35; margin: 0 0 8px; word-break: break-word; }
.err-loc { margin: 0 0 16px; font-size: 13px; color: var(--muted); }
.err-loc span { font-family: var(--mono); color: var(--foreground); }

.hint-box { border: 1px solid var(--border); background: var(--accent); padding: 14px 16px; margin-top: 12px; }
.hint-head { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; font-size: 13px; }
.hint-body { margin: 0; font-size: 13px; color: var(--foreground); font-family: var(--mono); }

.tabs { display: flex; border-bottom: 1px solid var(--border); gap: 4px; overflow-x: auto; }
.tabs button { border: 0; border-bottom: 2px solid transparent; background: none; color: var(--muted); height: 36px; padding: 0 14px; font-size: 13px; font-weight: 600; }
.tabs button:hover { color: var(--foreground); background: var(--accent); }
.tabs button.on { color: var(--foreground); border-bottom-color: var(--foreground); }

.workbench { display: grid; grid-template-columns: 300px minmax(0, 1fr); border: 1px solid var(--border); background: var(--card); }
.frame-pane { border-inline-end: 1px solid var(--border); display: flex; flex-direction: column; }
.pane-bar { display: flex; justify-content: space-between; align-items: center; padding: 8px 14px; border-bottom: 1px solid var(--border); background: var(--accent); font-size: 12px; font-weight: 600; color: var(--muted); min-height: 40px; }
.toggle-btn { height: 24px; padding: 0 8px; font-size: 11px; }

.frame-list { display: flex; flex-direction: column; max-height: 380px; overflow-y: auto; }
.frame-item { width: 100%; height: auto; display: grid; gap: 4px; text-align: start; justify-content: stretch; padding: 10px 14px; border: 0; border-bottom: 1px solid var(--border); border-inline-start: 3px solid transparent; background: var(--card); color: var(--foreground); cursor: pointer; }
.frame-item:hover { background: var(--accent); }
.frame-item.active { background: var(--accent); border-inline-start-color: var(--foreground); }
.frame-item.internal { opacity: 0.65; }
.frame-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
.frame-item .fn { font-family: var(--mono); font-size: 12px; font-weight: 600; color: var(--foreground); overflow: hidden; text-overflow: ellipsis; }
.frame-item .tag { font-family: var(--mono); font-size: 10px; text-transform: uppercase; padding: 1px 5px; border: 1px solid var(--border); color: var(--muted); }
.frame-item .file { font-family: var(--mono); font-size: 11px; color: var(--muted); word-break: break-all; white-space: normal; }

.source-pane { display: flex; flex-direction: column; min-width: 0; }
.terminal-code { background: var(--terminal-bg); color: var(--terminal-fg); padding: 14px 0; font-family: var(--mono); font-size: 13px; line-height: 1.7; overflow-x: auto; flex: 1; }
.code-line { display: flex; padding: 1px 16px; border-inline-start: 3px solid transparent; }
.code-line.target { background: rgba(239, 68, 68, 0.18); border-inline-start-color: var(--destructive); color: #ffffff; font-weight: 600; }
.ln { width: 40px; text-align: end; padding-inline-end: 16px; color: #71717a; user-select: none; flex-shrink: 0; }
.code-line.target .ln { color: var(--destructive); font-weight: 700; }
.src { white-space: pre; }

.context-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.context-grid .card { margin-bottom: 0; }
.context-grid th { width: 130px; }

@media (max-width: 780px) {
  .workbench { grid-template-columns: minmax(0, 1fr); }
  .frame-pane { border-inline-end: 0; border-bottom: 1px solid var(--border); }
  .context-grid { grid-template-columns: minmax(0, 1fr); }
}
</style>
