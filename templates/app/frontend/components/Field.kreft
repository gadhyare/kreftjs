<!-- A form field: its label, the input you put inside, and its error.
     <field label="Email" error={form.$error('email')}><input type="email" k-model="form.email"></field> -->
prop label = ''
prop error = ''
prop hint = ''

<view>
  <label class="field">
    <span class="label">{label}</span>
    <slot></slot>
    <small k-if="error" class="err" role="alert">{error}</small>
    <small k-elif="hint">{hint}</small>
  </label>
</view>

<style scoped>
.label { margin: 0; }
.err { color: var(--destructive); }
</style>
