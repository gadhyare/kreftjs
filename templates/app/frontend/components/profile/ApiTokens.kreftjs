<!-- API tokens: for scripts and other apps (Authorization: Bearer …). pages/Profile.kreftjs, /api/user/tokens -->
load tokens = api.get('/api/user/tokens')
state name = ''
state chosen = ['read']
state created = null          // the new token, shown once
state problem = ''

action create() {
  problem = ''
  try {
    created = await api.post('/api/user/tokens', { name, abilities: chosen })
    name = ''
    tokens.reload()
  } catch (e) { problem = e.message }
}
action toggle(a) { chosen = chosen.includes(a) ? chosen.filter((x) => x !== a) : [...chosen, a] }
action remove(t) {
  problem = ''
  try { await api.delete('/api/user/tokens/' + t.id); tokens.reload() }
  catch (e) { problem = e.message }
}
action copy() { navigator.clipboard && navigator.clipboard.writeText(created.token) }

<view>
  <div class="card">
    <h2>API tokens</h2>
    <p class="muted">Let a script or another app use your account through the API. Send the token as <code>Authorization: Bearer …</code>.</p>
    <p k-if="problem" class="alert danger" role="alert">{problem}</p>

    <form @submit.prevent={create}>
      <input k-model="name" placeholder="Token name, like Reports script" aria-label="Token name">
      <div class="abilities" k-if="tokens.data">
        {for a in tokens.data.abilities}
          <label><input type="checkbox" checked={chosen.includes(a)} @change="toggle(a)"> {a}</label>
        {/for}
      </div>
      <button class="primary" disabled={!name.trim() || !chosen.length}>Create token</button>
    </form>

    <div k-if="created" class="alert success new">
      <p><strong>{created.name}</strong>: copy it now. It is not shown again.</p>
      <div class="row"><code>{created.token}</code><button class="sm" @click={copy}>Copy</button></div>
    </div>

    <ul k-if="tokens.data && tokens.data.tokens.length" class="list">
      {for t in tokens.data.tokens key t.id}
        <li>
          <div>
            <strong>{t.name}</strong>
            <div class="muted small">{t.abilities.join(', ')} · {t.last_used_at ? 'last used ' + new Date(t.last_used_at).toLocaleDateString() : 'never used'}</div>
          </div>
          <button class="ghost sm" @click="remove(t)">Delete</button>
        </li>
      {/for}
    </ul>
  </div>
</view>

<style scoped>
form { display: grid; gap: 10px; max-width: 420px; margin: 12px 0; }
.abilities { display: flex; gap: 14px; flex-wrap: wrap; font-size: 14px; }
.abilities label { display: inline-flex; align-items: center; gap: 6px; }
form button { justify-self: start; }
.new code { word-break: break-all; }
.row { display: flex; align-items: center; gap: 8px; }
.list { list-style: none; padding: 0; margin: 12px 0 0; border: 1px solid var(--border); }
.list li { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 14px; border-bottom: 1px solid var(--border); }
.list li:last-child { border-bottom: 0; }
.small { font-size: 13px; }
</style>
