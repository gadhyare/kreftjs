<!-- A number with its label: <stat-card label="Users" value={stats.users} hint="new this week"></stat-card> -->
prop label = ''
prop value = 0
prop hint = ''

<view>
  <div class="stat-card">
    <p class="stat-label">{label}</p>
    <p class="stat-value">{value}</p>
    <p s-if="hint" class="stat-hint">{hint}</p>
  </div>
</view>

<style scoped>
.stat-card {
  border: 1px solid var(--border);
  padding: 20px;
  background: var(--card);
  transition: border-color .15s ease;
}
.stat-card:hover {
  border-color: var(--foreground);
}
.stat-label {
  margin: 0;
  font-size: 11px;
  font-weight: 600;
  font-family: var(--mono);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--muted);
}
.stat-value {
  margin: 8px 0 0;
  font-size: 32px;
  font-weight: 800;
  letter-spacing: -0.04em;
  font-variant-numeric: tabular-nums;
  line-height: 1;
  color: var(--foreground);
}
.stat-hint {
  margin: 8px 0 0;
  font-size: 12px;
  color: var(--muted);
}
</style>
