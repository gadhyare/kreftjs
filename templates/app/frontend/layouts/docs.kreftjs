<!-- The layout of the documentation page (/docs): a slim top bar and the page, without the dashboard sidebar.
     The route asks for it with .layout('docs') in routes/web.kreftjs. The documentation viewer (docs/Docs.kreftjs)
     assumes a bar this tall (60px) above it. -->
<view>
  <header>
    <kreft-link to="/" class="brand"><span class="mark" aria-hidden="true"></span>{env.PUBLIC_APP_NAME || 'My app'}</kreft-link>
    <span class="label">Documentation</span>
    <nav>
      <kreft-link to={$store.auth.user ? '/dashboard' : '/'} class="back">← {$store.auth.user ? 'Back to the app' : 'Home'}</kreft-link>
      <button type="button" class="theme" @click="theme.toggle()" aria-label="Toggle theme" title="Toggle theme">
        <span k-if="theme.dark">☀ Light</span>
        <span k-else>🌙 Dark</span>
      </button>
    </nav>
  </header>
  <main>
    <slot></slot>
  </main>
</view>

<style scoped>
header { position: sticky; top: 0; z-index: 50; display: flex; align-items: center; gap: 14px; height: 60px; padding: 0 var(--container-pad, 28px); background: var(--background); border-bottom: 1px solid var(--border); box-sizing: border-box; }
.brand { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 16px; letter-spacing: -0.02em; color: var(--foreground); text-decoration: none; }
.mark { width: 16px; height: 16px; background: var(--primary); }
.label { padding-inline-start: 14px; border-inline-start: 1px solid var(--border); font-size: 14px; color: var(--muted); }
nav { display: flex; align-items: center; gap: 10px; margin-inline-start: auto; }
.back { padding: 6px 10px; font-size: 14px; color: var(--muted); text-decoration: none; border-radius: var(--radius); }
.back:hover { color: var(--foreground); background: var(--accent); }
.theme { height: 34px; padding: 0 12px; background: var(--card); color: var(--foreground); border: 1px solid var(--border); border-radius: var(--radius); font: inherit; font-size: 13px; cursor: pointer; }
.theme:hover { background: var(--accent); }
main { width: 100%; max-width: calc(var(--container, 1240px) + var(--container-pad, 28px) * 2); margin: 0 auto; padding: 0 var(--container-pad, 28px) 48px; box-sizing: border-box; }
@media (max-width: 640px) {
  header { padding: 0 16px; gap: 10px; }
  .label { display: none; }
  main { padding: 0 16px 36px; }
}
</style>
