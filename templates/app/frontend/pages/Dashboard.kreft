<!--
  Dashboard Page: Default Overview UI for the application.
  Stat cards, user insights, and system status. Strictly zero border-radius and zero shadows.
-->
load stats = api.get('/api/admin/stats')
load board = api.get('/api/dashboard')

state docs = (Kreftjs.env.PUBLIC_DOCS_URL || 'http://kreftjs.com').replace(/\/+$/, '')   // where "Documentation" links go: PUBLIC_DOCS_URL in .env

<view>
  <div class="dashboard-page">
    <div class="dashboard-header">
      <div>
        <h1 class="dash-title">Dashboard Overview</h1>
        <p class="lead">
          System telemetry, user accounts, and platform status.
        </p>
      </div>
      <div class="header-actions">
        <kreft-link to="/users" class="btn primary sm">Manage Users →</kreft-link>
      </div>
    </div>

    <!-- Verified email toast notice if redirected from email verification -->
    <p k-if="$route.query.verified" class="alert success" role="status">
      Your email address has been successfully verified! Welcome to the dashboard.
    </p>

    <!-- Stat Cards Grid -->
    <div class="stats-grid">
      <stat-card
        label="Total Users"
        value={stats.data ? stats.data.users : 1}
        hint={stats.data && stats.data.newThisWeek ? stats.data.newThisWeek + ' joined this week' : 'Registered members'}>
      </stat-card>

      <stat-card
        label="Administrators"
        value={stats.data ? stats.data.admins : 1}
        hint="Full system access">
      </stat-card>

      <stat-card
        label="Email Verified"
        value={stats.data ? (stats.data.users - stats.data.unverified) : 1}
        hint="Active confirmed accounts">
      </stat-card>

      <stat-card
        label="Active Sessions"
        value={stats.data ? stats.data.signedIn : 1}
        hint="HttpOnly tokens">
      </stat-card>
    </div>

    <!-- Main Content Split Grid -->
    <div class="content-split">
      <!-- Recent Users Table -->
      <section class="card content-card">
        <div class="card-title-bar">
          <div>
            <h2 class="card-heading">Recent Accounts</h2>
            <p class="card-sub">Latest registered users in the database.</p>
          </div>
          <kreft-link to="/users" class="btn ghost sm">View All →</kreft-link>
        </div>

        <div k-if="stats.loading" class="state-msg muted">
          Loading user records…
        </div>
        <div k-elif="stats.data && stats.data.latest && stats.data.latest.length > 0">
          <table class="table">
            <thead>
              <tr>
                <th>User</th>
                <th>Email</th>
                <th>Role</th>
                <th>Joined</th>
              </tr>
            </thead>
            <tbody>
              {for u in stats.data.latest key u.id}
                <tr>
                  <td>
                    <div class="user-inline">
                      <span class="user-chip">{u.name ? u.name.charAt(0).toUpperCase() : 'U'}</span>
                      <strong>{u.name}</strong>
                    </div>
                  </td>
                  <td><code>{u.email}</code></td>
                  <td>
                    <span class={u.is_admin ? 'badge solid' : 'badge'}>
                      {u.is_admin ? 'Admin' : (u.role || 'User')}
                    </span>
                  </td>
                  <td class="muted font-mono">{String(u.created_at || '').slice(0, 10) || 'Recently'}</td>
                </tr>
              {/for}
            </tbody>
          </table>
        </div>
        <div k-else class="state-msg">
          <p class="muted">Signed in as <strong>{$store.auth.user ? $store.auth.user.name : 'Administrator'}</strong>.</p>
        </div>
      </section>

      <!-- System Quick Links & Info -->
      <section class="card content-card side-card">
        <h2 class="card-heading">Platform Architecture</h2>
        <p class="card-sub">Configured environment & quick developer tools.</p>

        <div class="info-list">
          <div class="info-item">
            <span class="info-label">Framework Engine</span>
            <span class="info-value">Kreft {Kreftjs.version || '0.0.9-beta'}</span>
          </div>
          <div class="info-item">
            <span class="info-label">Active Database</span>
            <span class="info-value">SQLite / Active Record</span>
          </div>
          <div class="info-item">
            <span class="info-label">UI Design System</span>
            <span class="info-value">High-Precision Brutalist</span>
          </div>
          <div class="info-item">
            <span class="info-label">Borders & Corners</span>
            <span class="info-value">Square (0px / No Shadows)</span>
          </div>
        </div>

        <div class="quick-nav-group">
          <kreft-link to="/profile" class="btn secondary sm w-full">Edit Profile Settings</kreft-link>
          <a href={docs + '/docs'} class="btn ghost sm w-full" target="_blank" rel="noopener">API Documentation</a>
          <kreft-link to="/welcome" class="btn ghost sm w-full">Landing Page Showcase</kreft-link>
        </div>
      </section>
    </div>
  </div>
</view>

<style scoped>
.dashboard-page {
  width: 100%;
  color: var(--foreground);
}

.dashboard-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  flex-wrap: wrap;
  margin-bottom: 24px;
}

.dash-title {
  margin: 0 0 6px;
  font-size: 28px;
  font-weight: 800;
  letter-spacing: -0.04em;
  color: var(--foreground);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.content-split {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 16px;
}

.content-card {
  margin-bottom: 0;
  padding: 24px;
  background: var(--card);
  color: var(--foreground);
  border: 1px solid var(--card-border);
}

.card-title-bar {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16px;
}

.card-heading {
  margin: 0 0 4px;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--foreground);
}

.card-sub {
  margin: 0;
  font-size: 12px;
  color: var(--muted);
}

.user-inline {
  display: flex;
  align-items: center;
  gap: 8px;
}

.user-chip {
  width: 20px;
  height: 20px;
  background: var(--primary);
  color: var(--primary-foreground);
  font-size: 10px;
  font-weight: 700;
  font-family: var(--mono);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.font-mono {
  font-family: var(--mono);
  font-size: 12px;
}

.state-msg {
  padding: 32px 0;
  text-align: center;
}

.info-list {
  display: grid;
  gap: 10px;
  margin: 16px 0 24px;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 8px;
  border-bottom: 1px solid var(--border);
  font-size: 12px;
}

.info-label {
  color: var(--muted);
  font-family: var(--mono);
}

.info-value {
  font-weight: 600;
  color: var(--foreground);
}

.quick-nav-group {
  display: grid;
  gap: 8px;
}

.w-full {
  width: 100%;
  justify-content: center;
}

@media (max-width: 900px) {
  .content-split {
    grid-template-columns: 1fr;
  }
}
</style>
