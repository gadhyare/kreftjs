<!--
  Users Management Page: Search, filter, inspect, and manage application users.
  Strictly zero border-radius and zero shadows.
-->
state q = ''
state page = 1
state problem = ''
state successMsg = ''

load users = api.get('/api/admin/users', { query: { q: q || undefined, page } })

watch q { page = 1 }

action setRole(user, role) {
  problem = ''
  successMsg = ''
  try {
    Object.assign(user, await api.patch('/api/admin/users/' + user.id, { role }))
    successMsg = 'Updated role for ' + user.name
  } catch (e) {
    problem = e.message
  }
}

action toggleAdmin(user) {
  problem = ''
  successMsg = ''
  try {
    Object.assign(user, await api.patch('/api/admin/users/' + user.id, { is_admin: !user.is_admin }))
    successMsg = (user.is_admin ? 'Granted' : 'Revoked') + ' admin permissions for ' + user.name
  } catch (e) {
    problem = e.message
  }
}

action remove(user) {
  problem = ''
  successMsg = ''
  if (!confirm('Are you sure you want to delete ' + user.name + '? This action cannot be undone.')) return
  try {
    await api.delete('/api/admin/users/' + user.id)
    successMsg = 'Deleted user ' + user.name
    users.reload()
  } catch (e) {
    problem = e.message
  }
}

<view>
  <div class="users-page">
    <div class="page-head">
      <div>
        <h1 class="page-title">Users</h1>
        <p class="lead">Manage registered user accounts, administrative permissions, and roles.</p>
      </div>
      <div class="search-box">
        <input type="search" s-model="q" placeholder="Search by name or email…" aria-label="Search users" class="search-input">
      </div>
    </div>

    <p s-if="problem" class="alert danger" role="alert">{problem}</p>
    <p s-if="successMsg" class="alert success" role="status">{successMsg}</p>

    <div s-if="users.loading && !users.data" class="loading-state">
      <p class="muted">Loading user accounts…</p>
    </div>

    <div s-elif="users.error" class="error-state">
      <p class="error">{users.error.message}</p>
      <button class="btn sm" @click="users.reload()">Retry</button>
    </div>

    <div s-elif="users.data" class="table-container">
      <table class="table">
        <thead>
          <tr>
            <th>User</th>
            <th>Email</th>
            <th>Verified</th>
            <th>Role</th>
            <th>Admin Status</th>
            <th class="actions-col">Actions</th>
          </tr>
        </thead>
        <tbody>
          {for u in users.data.data key u.id}
            <tr>
              <td>
                <div class="user-meta">
                  <span class="user-avatar-sq">{u.name ? u.name.charAt(0).toUpperCase() : 'U'}</span>
                  <strong>{u.name}</strong>
                </div>
              </td>
              <td><code>{u.email}</code></td>
              <td>
                <span class={u.email_verified_at ? 'badge success' : 'badge'}>
                  {u.email_verified_at ? 'Verified' : 'Pending'}
                </span>
              </td>
              <td>
                <select value={u.role} @change="setRole(u, $event.target.value)" aria-label={'Role of ' + u.name} class="role-select" disabled={!$store.auth.user || !$store.auth.user.is_admin}>
                  <option value="user">User</option>
                  <option value="editor">Editor</option>
                </select>
              </td>
              <td>
                <span class={u.is_admin ? 'badge solid' : 'badge'}>
                  {u.is_admin ? 'Admin' : 'Member'}
                </span>
              </td>
              <td class="actions-col">
                <button class="btn ghost sm" @click="toggleAdmin(u)" disabled={!$store.auth.user || !$store.auth.user.is_admin}>
                  {u.is_admin ? 'Revoke Admin' : 'Make Admin'}
                </button>
                <button class="btn danger sm" @click="remove(u)" disabled={!$store.auth.user || !$store.auth.user.is_admin || u.id === $store.auth.user.id}>
                  Delete
                </button>
              </td>
            </tr>
          {empty}
            <tr>
              <td colspan="6" class="empty-cell">
                <p class="muted">No user accounts found{q ? ' matching "' + q + '"' : ''}.</p>
              </td>
            </tr>
          {/for}
        </tbody>
      </table>

      <div class="table-pagination">
        <span class="muted pagination-info">
          {users.data.total} total users · Page {users.data.current_page} of {users.data.last_page || 1}
        </span>
        <div class="pagination-buttons">
          <button class="btn sm" disabled={page <= 1} @click="page--">Previous</button>
          <button class="btn sm" disabled={page >= users.data.last_page} @click="page++">Next</button>
        </div>
      </div>
    </div>
  </div>
</view>

<style scoped>
.users-page {
  width: 100%;
}

.page-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  flex-wrap: wrap;
  margin-bottom: 24px;
}

.page-title {
  margin: 0 0 6px;
  font-size: 28px;
  font-weight: 800;
  letter-spacing: -0.04em;
}

.search-box {
  min-width: 260px;
}

.search-input {
  width: 100%;
}

.table-container {
  border: 1px solid var(--border);
  background: var(--card);
}

.user-meta {
  display: flex;
  align-items: center;
  gap: 10px;
}

.user-avatar-sq {
  width: 24px;
  height: 24px;
  background: var(--primary);
  color: var(--primary-foreground);
  font-size: 11px;
  font-weight: 700;
  font-family: var(--mono);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.role-select {
  height: 30px;
  padding: 0 8px;
  font-size: 12px;
}

.actions-col {
  text-align: end;
  white-space: nowrap;
}

.empty-cell {
  text-align: center;
  padding: 40px 16px;
}

.table-pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  border-top: 1px solid var(--border);
  background: var(--accent);
}

.pagination-info {
  font-family: var(--mono);
  font-size: 12px;
}

.pagination-buttons {
  display: flex;
  gap: 8px;
}

@media (max-width: 768px) {
  .page-head {
    flex-direction: column;
    align-items: stretch;
  }
  .search-box {
    width: 100%;
  }
}
</style>
