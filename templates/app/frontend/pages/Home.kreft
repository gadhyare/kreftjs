  .cta-actions { flex-direction: column; align-items: stretch; width: 100%; }
  .pill-btn { width: 100%; min-height: 46px; text-align: center; }
  .feature-badges { gap: 6px; }
  .badge { font-size: 11.5px; padding: 5px 10px; }
  .terminal-code { font-size: 12.5px; padding: 18px 16px 44px; }
  .floating-preview { padding: 18px; }
  .language, .inside, .begin { padding: 40px 0; }
  .inside ul { grid-template-columns: 1fr; }
  dl { grid-template-columns: 1fr; }
  dl div { grid-template-columns: 1fr; gap: 4px; }
  .term { max-width: 100%; }
  .term code { min-width: 0; overflow-x: auto; white-space: nowrap; }
  .site-foot { flex-wrap: wrap; gap: 8px 16px; }
}
@media (max-width: 380px) {
  .hero-headline { font-size: 28px; }
  .version-pill, .hero-kicker { font-size: 11.5px; }
