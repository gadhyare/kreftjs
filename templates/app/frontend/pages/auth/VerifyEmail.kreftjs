<!-- /verify-email: "check your email", with a button to send the link again.
     /verify-email/:id/:hash?expires=…&signature=…: the link from the email, which verifies the address. -->
prop id = ''
prop hash = ''

state status = ''
state problem = ''
state busy = false
state checking = Boolean(id && hash)

on ready {
  if (!id || !hash) return
  try {
    const res = await api.post('/api/email/verify', { id, hash, expires: $route.query.expires, signature: $route.query.signature })
    if ($store.auth.user && res.user && $store.auth.user.id === res.user.id) Object.assign($store.auth.user, res.user)
    $router.replace($store.auth.user ? '/dashboard?verified=1' : '/login?status=' + encodeURIComponent(res.message + ' Log in to go on.'))
  } catch (e) {
    problem = e.message
    checking = false
  }
}

action resend() {
  problem = ''
  busy = true
  try { status = (await api.post('/api/email/verification-notification')).message }
  catch (e) { problem = e.message }
  finally { busy = false }
}
action logout() {
  await $store.auth.logout()
  $router.replace('/login')
}

<view>
  <div k-if="checking">
    <h1>Checking your link…</h1>
    <p class="lead">One moment.</p>
  </div>
  <div k-else>
    <h1>Verify your email</h1>
    <p class="lead" k-if="$store.auth.user">We sent a link to <strong>{$store.auth.user.email}</strong>. Open it to finish making your account.</p>
    <p class="lead" k-else>Open the link in the email we sent you.</p>
    <p class="muted small">While you work on the app, the email is printed in the terminal where <code>npm run dev</code> runs.</p>
    <p k-if="status" class="alert success" role="status">{status}</p>
    <p k-if="problem" class="alert danger" role="alert">{problem}</p>
    <div class="actions" k-if="$store.auth.user">
      <button class="primary" @click={resend} disabled={busy}>{busy ? 'Sending…' : 'Send the link again'}</button>
      <button class="ghost" @click={logout}>Log out</button>
    </div>
    <p k-else><kreft-link to="/login">Log in</kreft-link> to get a new link.</p>
  </div>
</view>

<style scoped>
h1 { font-size: 24px; }
.small { font-size: 13px; }
.actions { display: flex; justify-content: space-between; gap: 8px; margin-top: 20px; }
</style>
