<!-- /reset-password/:token?email=…: the link from the email. Choose a new password (POST /api/reset-password) -->
prop token = ''

state f = form(
  { email: $route.query.email || '', password: '', password_confirmation: '' },
  { email: 'required|email', password: 'required|min:8|confirmed' },
)
state problem = ''

action submit() {
  problem = ''
  try {
    const res = await f.$submit((values) => api.post('/api/reset-password', { ...values, token }))
    if (res) $router.replace('/login?status=' + encodeURIComponent(res.message))
  } catch (e) {
    problem = e.message
  }
}

<view>
  <h1>Choose a new password</h1>
  <p class="lead">After this, you'll be logged out on every device.</p>
  <p k-if="problem" class="alert danger" role="alert">{problem}</p>

  <form @submit.prevent={submit} novalidate>
    <field label="Email" error={f.$error('email')}>
      <input type="email" k-model="f.email" autocomplete="username">
    </field>
    <field label="New password" error={f.$error('password')} hint="At least 8 characters.">
      <input type="password" k-model="f.password" autocomplete="new-password" autofocus>
    </field>
    <field label="Confirm new password" error={f.$error('password_confirmation')}>
      <input type="password" k-model="f.password_confirmation" autocomplete="new-password">
    </field>
    <button class="primary wide" disabled={f.$busy}>{f.$busy ? 'Saving…' : 'Reset password'}</button>
  </form>

  <p class="links"><kreft-link to="/forgot-password">Ask for a new link</kreft-link></p>
</view>

<style scoped>
h1 { font-size: 24px; }
.wide { width: 100%; margin-top: 4px; }
.links { margin: 20px 0 0; font-size: 13px; }
</style>
