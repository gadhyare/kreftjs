<!-- /forgot-password: email a link to choose a new password (POST /api/forgot-password) -->
state f = form({ email: '' }, { email: 'required|email' })
state sent = ''
state problem = ''

action submit() {
  problem = ''
  try {
    const res = await f.$submit((values) => api.post('/api/forgot-password', values))
    if (res) sent = res.message
  } catch (e) {
    problem = e.message
  }
}

<view>
  <h1>Forgot your password?</h1>
  <p class="lead">Type the email address of your account and we'll send you a link to choose a new password.</p>
  <p s-if="sent" class="alert success" role="status">{sent}</p>
  <p s-if="problem" class="alert danger" role="alert">{problem}</p>

  <form @submit.prevent={submit} novalidate>
    <field label="Email" error={f.$error('email')}>
      <input type="email" s-model="f.email" autocomplete="username" autofocus>
    </field>
    <button class="primary wide" disabled={f.$busy}>{f.$busy ? 'Sending…' : 'Email me a reset link'}</button>
  </form>

  <p class="links"><som-link to="/login">Back to log in</som-link></p>
</view>

<style scoped>
h1 { font-size: 24px; }
.wide { width: 100%; margin-top: 4px; }
.links { margin: 20px 0 0; font-size: 13px; }
</style>
