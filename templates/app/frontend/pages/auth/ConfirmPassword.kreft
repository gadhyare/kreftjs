<!-- /confirm-password: type the password again before something serious, like deleting the account.
     A route with 'password.confirm' answers 423 until this was done (for 3 hours), and the app comes here. -->
state f = form({ password: '' }, { password: 'required' })
state problem = ''

action submit() {
  problem = ''
  try {
    const ok = await f.$submit((values) => api.post('/api/confirm-password', values))
    if (!ok) return
    const to = String($route.query.redirect || '')
    $router.replace(to.startsWith('/') && !to.startsWith('//') ? to : '/dashboard')
  } catch (e) {
    problem = e.message
  }
}

<view>
  <h1>Confirm your password</h1>
  <p class="lead">This is a secure part of the app. Type your password to go on.</p>
  <p k-if="problem" class="alert danger" role="alert">{problem}</p>
  <form @submit.prevent={submit} novalidate>
    <field label="Password" error={f.$error('password')}>
      <input type="password" k-model="f.password" autocomplete="current-password" autofocus>
    </field>
    <button class="primary wide" disabled={f.$busy}>{f.$busy ? 'Checking…' : 'Confirm'}</button>
  </form>
</view>

<style scoped>
h1 { font-size: 24px; }
.wide { width: 100%; margin-top: 4px; }
</style>
