// Application Web Routes.
// Developers can attach custom auth guards directly: .middleware('auth', 'admin') or custom guards.

// Public Welcome & Showcase Page (shows first with links to Sign Up, Log In, Docs)
Route.view('/', 'pages/Home.kreft').layout('none').name('home').title('Welcome')
Route.view('/welcome', 'pages/Home.kreft').layout('none').name('welcome').title('Welcome')

// Protected Dashboard & management pages (requires signed-in user)
Route.middleware('auth').group(() => {
  Route.view('/dashboard', 'pages/Dashboard.kreft').name('dashboard').title('Dashboard')
  Route.view('/users', 'pages/Users.kreft').name('users').title('Users')
  Route.view('/profile', 'pages/Profile.kreft').name('profile').title('Profile')
})

// Authentication routes (pages/auth/), wrapped in guest layout
Route.layout('guest').group(() => {
  Route.middleware('guest').group(() => {
    Route.view('/login', 'pages/auth/Login.kreft').name('login').title('Log In')
    Route.view('/register', 'pages/auth/Register.kreft').name('register').title('Register')
    Route.view('/forgot-password', 'pages/auth/ForgotPassword.kreft').name('password.request').title('Forgot Password')
  })
  Route.view('/reset-password/:token', 'pages/auth/ResetPassword.kreft').name('password.reset').title('Reset Password')
  Route.view('/verify-email/:id?/:hash?', 'pages/auth/VerifyEmail.kreft').name('verification.notice').title('Verify Email')
  Route.view('/confirm-password', 'pages/auth/ConfirmPassword.kreft').name('password.confirm').title('Confirm Password').middleware('auth')
})

// Documentation (docs/) and test suite (tests/)
Route.view('/docs', 'docs/Docs.kreft').name('docs').title('Documentation').layout('docs')   // its own slim bar, not the dashboard sidebar
Route.view('/error-monitor', 'pages/ErrorMonitor.kreft').name('error-monitor').title('Error Monitor')
Route.prefix('/tests').name('tests.').group(() => {
  Route.view('/', 'tests/pages/Test.kreft').name('index').title('Test Suite')
  Route.view('/about', 'tests/pages/About.kreft').name('about').title('About · Tests')
})

