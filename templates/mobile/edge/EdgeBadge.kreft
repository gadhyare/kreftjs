<!-- A small number or dot, for icons: <edge-badge value={3}></edge-badge>  <edge-badge dot></edge-badge> -->
prop value = ''
prop dot = false
prop max = 99
prop tone = 'danger'

derive shown = dot || (value !== '' && value !== 0 && value !== null && value !== false && value !== undefined)
derive label = typeof value === 'number' && value > max ? max + '+' : String(value)

<view>
  <span k-if="shown" class="ebadge tone-{tone} {dot ? 'dot' : ''}" role="status">{dot ? '' : label}</span>
</view>

<style scoped>
.ebadge { display: inline-flex; align-items: center; justify-content: center; min-width: 18px; height: 18px; padding: 0 5px; box-sizing: border-box; border-radius: 999px; font-size: 11px; font-weight: 700; line-height: 1; color: #fff; background: var(--edge-danger); }
.ebadge.dot { min-width: 10px; width: 10px; height: 10px; padding: 0; }
.ebadge.tone-accent { background: var(--edge-accent); } .ebadge.tone-success { background: var(--edge-success); }
.ebadge.tone-warning { background: var(--edge-warning); } .ebadge.tone-muted { background: var(--edge-muted); }
</style>
