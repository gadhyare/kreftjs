<!-- A web page inside the app. <edge-web-view src="https://example.com" height={400} @load={done}></edge-web-view>
     src (http, https or a path of your app)      height (px; default fills the parent)      sandbox: what the page may do (default: scripts, forms and popups, but not your app's data)      title
     Only http(s) and relative addresses open; javascript: and data: are refused. Many sites refuse to be shown inside other pages. -->
prop src = ''
prop height = 0
prop sandbox = 'allow-scripts allow-forms allow-popups allow-popups-to-escape-sandbox'
prop title = 'Web page'
event load
event error

state loading = true

derive safe = /^(https?:\/\/|\.{0,2}\/(?!\/)|[\w-][\w./-]*$)/i.test(src) && !/^(javascript|data|vbscript|file):/i.test(src)
derive st = ({ height: height ? height + 'px' : null })

watch src { loading = true }
action done() { loading = false; send('load') }
action bad() { loading = false; send('error') }

<view>
  <div class="wv" :style="st">
    <edge-activity-indicator k-if="loading && safe" class="spin"></edge-activity-indicator>
    <iframe k-if="safe" src={src} title={title} sandbox={sandbox} referrerpolicy="no-referrer" loading="lazy" @load="done()" @error="bad()"></iframe>
    <p k-else class="msg">This address can't be shown.</p>
  </div>
</view>

<style scoped>
.wv { position: relative; width: 100%; min-height: 120px; background: var(--edge-surface); }
iframe { display: block; width: 100%; height: 100%; min-height: inherit; border: 0; background: #fff; }
.spin { position: absolute; top: 50%; left: 50%; margin: -14px 0 0 -14px; }
.msg { margin: 0; padding: 24px; text-align: center; color: var(--edge-muted); }
</style>
