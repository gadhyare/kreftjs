<!-- Pull down to refresh. The box scrolls; at the top, pulling down starts a refresh.
     <edge-refreshable refreshing={busy} @refresh={reload}>…list…</edge-refreshable>   action reload() { busy = true; await load(); busy = false }
     refreshing: show the spinner while you work      threshold (px to pull, default 70)      height (px; default: fills its parent) -->
prop refreshing = false
prop threshold = 70
prop height = 0
event refresh

state pull = 0
state box = null
let startY = null

derive st = ({ height: height ? height + 'px' : null })
derive ind = ({ transform: 'translateY(' + (refreshing ? 8 : Math.min(pull, threshold * 1.4) - 40) + 'px)', opacity: refreshing ? 1 : Math.min(1, pull / threshold) })
derive body = ({ transform: pull || refreshing ? 'translateY(' + (refreshing ? 48 : Math.min(pull, threshold * 1.4)) + 'px)' : null, transition: startY === null ? 'transform .2s ease' : 'none' })

action down(e) { if (box && box.scrollTop <= 0 && !refreshing) startY = e.touches[0].clientY }
action move(e) {
  if (startY === null) return
  const dy = e.touches[0].clientY - startY
  if (dy > 0 && box.scrollTop <= 0) { pull = dy * 0.5; if (e.cancelable) e.preventDefault() } else { pull = 0 }
}
action up() {
  if (startY === null) return
  const fire = pull >= threshold
  startY = null
  pull = 0
  if (fire) { if (Kreftjs.native) Kreftjs.native.haptics.impact('light'); send('refresh') }
}

<view>
  <div class="rf" :style="st">
    <div class="ind" :style="ind" aria-hidden="true"><edge-activity-indicator size={24}></edge-activity-indicator></div>
    <div k-ref="box" class="scroll" :style="body" @touchstart.passive="down($event)" @touchmove="move($event)" @touchend="up()" @touchcancel="up()"><slot></slot></div>
  </div>
</view>

<style scoped>
.rf { position: relative; overflow: hidden; min-height: 0; display: flex; flex-direction: column; }
.ind { position: absolute; top: 0; left: 0; right: 0; z-index: 1; display: flex; justify-content: center; pointer-events: none; transition: opacity .15s ease; }
.scroll { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior-y: contain; -webkit-overflow-scrolling: touch; }
</style>
