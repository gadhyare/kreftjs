<!-- errors/500.som: shown when a page can't be loaded, and after abort(500). The details are in the browser console. Change the words as you like. -->
layout 'errors/minimal.som'
prop status = 500
prop title = ''
prop message = ''

<view>
  <som-section name="code">500</som-section>
  <som-section name="title">Server Error</som-section>
  <som-section name="message">Something went wrong on our side. Try again in a moment.</som-section>
</view>
