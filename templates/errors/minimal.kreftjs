<!-- errors/minimal.kreftjs: the frame every error page uses.
     Each page fills it with <kreft-section name="code">, "title" and "message". -->
<view>
  <main class="error-page">
    <p class="line">
      <span class="code"><kreft-yield name="code"></kreft-yield></span>
      <span class="title"><kreft-yield name="title"></kreft-yield></span>
    </p>
    <p class="message"><kreft-yield name="message"></kreft-yield></p>
    <div class="actions">
      <kreft-link to="/" class="btn primary">Go home</kreft-link>
      <button @click="history.back()">Go back</button>
    </div>
    <slot></slot> <!-- the error page itself: it fills the sections above, and can add more here -->
  </main>
</view>

<style scoped>
.error-page { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0; padding: 32px 20px; text-align: center; }
.line { display: flex; align-items: center; gap: 16px; margin: 0 0 12px; font-size: 18px; }
.code { font-family: var(--mono, ui-monospace, monospace); font-weight: 600; padding-right: 16px; border-right: 1px solid var(--border, #e4e4e7); }
.title { font-weight: 500; letter-spacing: -0.01em; }
.message { margin: 0 0 24px; max-width: 30em; color: var(--muted, #71717a); }
.actions { display: flex; gap: 8px; }
</style>
