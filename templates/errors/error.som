<!-- errors/error.som: any other status, like abort(409) or abort(422, 'That name is taken.') -->
layout 'errors/minimal.som'
prop status = 400
prop title = 'Error'
prop message = ''

<view>
  <som-section name="code">{status}</som-section>
  <som-section name="title">{title}</som-section>
  <som-section name="message">{message || 'Something went wrong with this request.'}</som-section>
</view>
