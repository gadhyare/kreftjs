<!-- errors/403.som: shown after abort(403), or abort(403, 'Only the owner can see this.'). Change the words as you like. -->
layout 'errors/minimal.som'
prop status = 403
prop title = ''
prop message = ''

<view>
  <som-section name="code">403</som-section>
  <som-section name="title">Forbidden</som-section>
  <som-section name="message">{message || "You don't have permission to see this page."}</som-section>
</view>
