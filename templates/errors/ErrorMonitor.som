<!--
  ErrorMonitor.som: Enterprise-Grade Interactive Error Monitoring & Debugging UI for Som.js
  Provides stack traces, interactive code inspectors, context variables, and smart solution suggestions.
-->
prop error = null
prop status = 500
prop title = ''
prop message = ''
prop frames = []
prop solution = null
prop request = null

state activeTab = 'stack'
state selectedFrameIndex = 0
state showAllVendorFrames = false
state copiedToast = false

derive currentTitle = title || (error && error.name) || 'UnhandledException'
derive currentMessage = message || (error && error.message) || 'An unexpected error occurred during execution.'
derive frameList = (frames && frames.length) ? frames : (error && error.frames ? error.frames : [
  { fn: 'HomeController.__invoke', file: 'app/Http/Controllers/Discovery/HomeController.som', line: 14, col: 5, isApp: true, snippet: [
    { num: 10, code: 'class HomeController {' },
    { num: 11, code: '  action index() {' },
    { num: 12, code: '    // Query active records' },
    { num: 13, code: '    load posts = Post.qquery()' },
    { num: 14, code: '    return view("pages/Home.som", { posts })', isTarget: true },
    { num: 15, code: '  }' },
    { num: 16, code: '}' }
  ]},
  { fn: 'Route.dispatch', file: 'bin/backend/http.js', line: 182, col: 12, isApp: false },
  { fn: 'Server.handleRequest', file: 'bin/som.js', line: 412, col: 9, isApp: false },
  { fn: 'processTicksAndRejections', file: 'node:internal/process/task_queues', line: 95, col: 5, isApp: false }
])

derive activeFrame = frameList[selectedFrameIndex] || frameList[0] || {}
derive activeSnippet = activeFrame.snippet || [
  { num: Math.max(1, (activeFrame.line || 1) - 2), code: '// Context before call' },
  { num: Math.max(1, (activeFrame.line || 1) - 1), code: 'const record = await findRecord(id);' },
  { num: activeFrame.line || 1, code: activeFrame.code || '// Error occurred on this line', isTarget: true },
  { num: (activeFrame.line || 1) + 1, code: 'return renderResponse(record);' },
  { num: (activeFrame.line || 1) + 2, code: '}' }
]

derive smartSolution = solution || (currentMessage.includes('qquery') ? {
  title: 'Bad Method Call',
  message: 'Did you mean to call query() instead of qquery()?'
} : currentMessage.includes('undefined') ? {
  title: 'Null Reference Protection',
  message: 'Verify that the target object is defined or use optional chaining (?.) to prevent runtime crashes.'
} : {
  title: 'Debugging Recommendation',
  message: 'Inspect the highlighted line in the source preview and verify your input parameters and dependencies.'
})

action selectFrame(index) {
  selectedFrameIndex = index
}

action toggleVendor() {
  showAllVendorFrames = !showAllVendorFrames
}

action copyReport() {
  const report = [
    '### Som.js Error Report',
    '**' + currentTitle + '**: ' + currentMessage,
    '**File**: `' + (activeFrame.file || 'unknown') + ':' + (activeFrame.line || '0') + '`',
    '',
    '```text',
    (error && error.stack) || frameList.map(f => '  at ' + (f.fn || '<anonymous>') + ' (' + f.file + ':' + f.line + ')').join('\n'),
    '```'
  ].join('\n')

  if (typeof navigator !== 'undefined' && navigator.clipboard) {
    navigator.clipboard.writeText(report).then(() => {
      copiedToast = true
      setTimeout(() => { copiedToast = false }, 2500)
    })
  }
}

<view>
  <div class="error-monitor-wrapper">
    <!-- Top Navigation Bar -->
    <header class="monitor-navbar">
      <div class="nav-tabs">
        <button class={'nav-tab' + (activeTab === 'stack' ? ' active' : '')} @click="activeTab = 'stack'">
          <span class="tab-icon">☰</span>
          <span>STACK</span>
        </button>
        <button class={'nav-tab' + (activeTab === 'context' ? ' active' : '')} @click="activeTab = 'context'">
          <span class="tab-icon">⚏</span>
          <span>CONTEXT</span>
        </button>
        <button class={'nav-tab' + (activeTab === 'share' ? ' active' : '')} @click="activeTab = 'share'">
          <span class="tab-icon">↗</span>
          <span>SHARE</span>
        </button>
      </div>

      <div class="nav-meta">
        <som-link to="/docs" class="nav-link-docs">
          <span class="tab-icon">📖</span>
          <span>DOCS</span>
        </som-link>
        <button class="btn-copy-report" @click={copyReport}>
          {copiedToast ? '✓ Copied' : 'Copy Report'}
        </button>
        <span class="status-tag">{status}</span>
      </div>
    </header>

    <!-- Hero Error Banner -->
    <section class="error-hero">
      <div class="hero-details">
        <div class="hero-badges">
          <span class="badge-exception">{currentTitle}</span>
          <span class="badge-env">Node.js {typeof process !== 'undefined' ? process.version : 'v22.0.0'}</span>
          <span class="badge-env">Som.js v2.5.0</span>
        </div>
        <h1 class="hero-error-message">{currentMessage}</h1>
      </div>

      <!-- Smart Suggestion Card -->
      <div class="solution-card" s-if="smartSolution">
        <div class="solution-header">
          <div class="solution-title">💡 {smartSolution.title}</div>
        </div>
        <p class="solution-body">{smartSolution.message}</p>
      </div>
    </section>

    <!-- Tab 1: STACK (Split 2-Column Inspector) -->
    <section class="tab-pane-stack" s-if="activeTab === 'stack'">
      <!-- Left Column: Frames List -->
      <aside class="frames-column">
        <div class="frames-toolbar">
          <button class="btn-toggle-vendor" @click={toggleVendor}>
            {showAllVendorFrames ? 'Collapse vendor frames ↑' : 'Expand vendor frames ↓'}
          </button>
        </div>

        <div class="frames-list">
          <div
            s-for="(frame, idx) in frameList"
            s-if="frame.isApp || showAllVendorFrames"
            class={'frame-card' + (selectedFrameIndex === idx ? ' active' : '') + (frame.isApp ? ' is-app' : ' is-vendor')}
            @click="selectFrame(idx)">
            <div class="frame-file-line">{frame.file}:{frame.line || 1}</div>
            <div class="frame-fn-name">{frame.fn || '<anonymous>'}</div>
          </div>
        </div>
      </aside>

      <!-- Right Column: Source Code Inspector -->
      <main class="code-column">
        <div class="code-toolbar">
          <span class="code-filepath">{activeFrame.file || 'source.js'}:{activeFrame.line || 1}</span>
          <span class="code-line-info">Line {activeFrame.line || 1}</span>
        </div>

        <div class="code-body">
          <div class="code-line-row" s-for="line in activeSnippet" class={'code-line-row' + (line.isTarget ? ' target' : '')}>
            <span class="line-number">{line.num}</span>
            <span class="line-text">{line.code}</span>
          </div>
        </div>
      </main>
    </section>

    <!-- Tab 2: CONTEXT -->
    <section class="tab-pane-context" s-if="activeTab === 'context'">
      <div class="context-grid">
        <div class="context-card">
          <h3 class="context-title">HTTP Request</h3>
          <table class="context-table">
            <tr><th>Method</th><td>{request && request.method ? request.method : 'GET'}</td></tr>
            <tr><th>URL</th><td>{request && request.url ? request.url : (typeof window !== 'undefined' ? window.location.pathname : '/')}</td></tr>
            <tr><th>Host</th><td>{typeof window !== 'undefined' ? window.location.host : 'localhost:8000'}</td></tr>
            <tr><th>Protocol</th><td>HTTP/1.1</td></tr>
          </table>
        </div>

        <div class="context-card">
          <h3 class="context-title">Session & Environment</h3>
          <table class="context-table">
            <tr><th>Session Driver</th><td>cookie</td></tr>
            <tr><th>Session Lifetime</th><td>120 minutes</td></tr>
            <tr><th>Debug Mode</th><td>Enabled (APP_DEBUG=true)</td></tr>
            <tr><th>Security Watchdog</th><td>Active (Anti-XSS & Prototype-Safe)</td></tr>
          </table>
        </div>
      </div>
    </section>

    <!-- Tab 3: SHARE -->
    <section class="tab-pane-share" s-if="activeTab === 'share'">
      <div class="share-card">
        <h3>Export Diagnostic Report</h3>
        <p>Copy this debug report into GitHub Issues, Discord, or your team issue tracker:</p>
        <pre class="share-preview"><code>### Som.js Exception
{currentTitle}: {currentMessage}
Location: {activeFrame.file}:{activeFrame.line}</code></pre>
        <button class="btn primary" @click={copyReport}>
          {copiedToast ? '✓ Copied to Clipboard' : 'Copy Full Markdown Report'}
        </button>
      </div>
    </section>
  </div>
</view>

<style scoped>
*, *::before, *::after {
  box-sizing: border-box;
  border-radius: 0 !important;
}
.error-monitor-wrapper {
  background: #f8fafc;
  color: #0f172a;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  padding: 0;
  margin: 0;
}
.monitor-navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  border-bottom: 2px solid #ef4444;
  padding: 0 24px;
  height: 52px;
}
.nav-tabs {
  display: flex;
  height: 100%;
  gap: 8px;
}
.nav-tab {
  background: none;
  border: none;
  color: #64748b;
  font-weight: 700;
  font-size: 13px;
  letter-spacing: 0.05em;
  padding: 0 16px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  position: relative;
  transition: color 0.15s;
}
.nav-tab:hover {
  color: #0f172a;
}
.nav-tab.active {
  color: #ef4444;
  border-bottom: 2px solid #ef4444;
}
.nav-meta {
  display: flex;
  align-items: center;
  gap: 12px;
}
.nav-link-docs {
  color: #64748b;
  font-size: 12px;
  font-weight: 700;
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 4px;
}
.btn-copy-report {
  background: #0f172a;
  color: #ffffff;
  border: none;
  padding: 6px 12px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
}
.status-tag {
  background: #ef4444;
  color: #ffffff;
  font-weight: 800;
  font-size: 12px;
  padding: 4px 8px;
  font-family: monospace;
}
.error-hero {
  background: #ffffff;
  border-bottom: 1px solid #e2e8f0;
  padding: 28px 24px;
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 24px;
  align-items: start;
}
.hero-badges {
  display: flex;
  gap: 8px;
  align-items: center;
  margin-bottom: 10px;
}
.badge-exception {
  background: #fee2e2;
  color: #b91c1c;
  font-family: monospace;
  font-weight: 700;
  font-size: 13px;
  padding: 3px 8px;
}
.badge-env {
  color: #64748b;
  font-size: 12px;
  font-family: monospace;
}
.hero-error-message {
  font-size: 24px;
  font-weight: 800;
  color: #0f172a;
  margin: 0;
  line-height: 1.3;
  word-break: break-word;
}
.solution-card {
  background: #a7f3d0;
  border: 1px solid #6ee7b7;
  padding: 16px 20px;
  color: #064e3b;
}
.solution-title {
  font-weight: 800;
  font-size: 14px;
  margin-bottom: 6px;
}
.solution-body {
  margin: 0;
  font-size: 13px;
  line-height: 1.5;
}
.tab-pane-stack {
  display: grid;
  grid-template-columns: 340px 1fr;
  height: calc(100vh - 170px);
  overflow: hidden;
}
.frames-column {
  background: #ffffff;
  border-right: 1px solid #e2e8f0;
  overflow-y: auto;
}
.frames-toolbar {
  padding: 10px 16px;
  border-bottom: 1px solid #e2e8f0;
  background: #f8fafc;
}
.btn-toggle-vendor {
  background: #ffffff;
  border: 1px solid #cbd5e1;
  padding: 5px 10px;
  font-size: 11px;
  font-weight: 600;
  color: #475569;
  cursor: pointer;
  width: 100%;
}
.frame-card {
  padding: 12px 16px;
  border-bottom: 1px solid #f1f5f9;
  cursor: pointer;
  transition: all 0.15s;
}
.frame-card:hover {
  background: #f8fafc;
}
.frame-card.active {
  background: #ef4444 !important;
  color: #ffffff;
}
.frame-card.active .frame-file-line,
.frame-card.active .frame-fn-name {
  color: #ffffff !important;
}
.frame-file-line {
  font-family: monospace;
  font-size: 11px;
  color: #64748b;
  margin-bottom: 3px;
  word-break: break-all;
}
.frame-fn-name {
  font-weight: 700;
  font-size: 13px;
  color: #1e293b;
}
.frame-card.is-vendor {
  opacity: 0.6;
}
.code-column {
  background: #ffffff;
  overflow-y: auto;
}
.code-toolbar {
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
  padding: 10px 20px;
  display: flex;
  justify-content: space-between;
  font-family: monospace;
  font-size: 12px;
  color: #64748b;
}
.code-filepath {
  font-weight: 600;
  color: #334155;
}
.code-body {
  padding: 16px 0;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 13px;
  line-height: 1.7;
}
.code-line-row {
  display: flex;
  padding: 1px 20px;
}
.code-line-row.target {
  background: #fee2e2;
  border-left: 4px solid #ef4444;
  color: #991b1b;
  font-weight: 600;
}
.line-number {
  width: 48px;
  text-align: right;
  padding-right: 18px;
  color: #94a3b8;
  user-select: none;
  flex-shrink: 0;
}
.code-line-row.target .line-number {
  color: #ef4444;
  font-weight: 800;
}
.line-text {
  white-space: pre-wrap;
  word-break: break-all;
}
.tab-pane-context, .tab-pane-share {
  padding: 32px 24px;
  max-width: var(--container, 1240px);
  margin: 0 auto;
}
.context-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}
.context-card, .share-card {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  padding: 20px;
}
.context-title {
  margin: 0 0 16px;
  font-size: 15px;
  font-weight: 700;
  color: #0f172a;
}
.context-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}
.context-table th, .context-table td {
  border: 1px solid #e2e8f0;
  padding: 8px 12px;
  text-align: left;
}
.context-table th {
  background: #f8fafc;
  color: #475569;
  width: 160px;
  font-family: monospace;
}
.share-preview {
  background: #0f172a;
  color: #f8fafc;
  padding: 16px;
  font-family: monospace;
  font-size: 12px;
  overflow-x: auto;
}
@media (max-width: 900px) {
  .error-hero { grid-template-columns: 1fr; }
  .tab-pane-stack { grid-template-columns: 1fr; height: auto; }
  .context-grid { grid-template-columns: 1fr; }
}
</style>
