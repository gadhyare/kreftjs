<!-- errors/503.kreft: shown after abort(503), for example during maintenance. Change the words as you like. -->
layout 'errors/minimal.kreft'
prop status = 503
prop title = ''
prop message = ''

<view>
  <kreft-section name="code">503</kreft-section>
  <kreft-section name="title">Service Unavailable</kreft-section>
  <kreft-section name="message">{message || "We're doing some maintenance. Please check back soon."}</kreft-section>
</view>
