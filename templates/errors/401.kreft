<!-- errors/401.kreft: shown after abort(401), for example when the API says the visitor isn't signed in. Change the words as you like. -->
layout 'errors/minimal.kreft'
prop status = 401
prop title = ''
prop message = ''

<view>
  <kreft-section name="code">401</kreft-section>
  <kreft-section name="title">Unauthorized</kreft-section>
  <kreft-section name="message">{message || 'You need to sign in to see this page.'}</kreft-section>
</view>
